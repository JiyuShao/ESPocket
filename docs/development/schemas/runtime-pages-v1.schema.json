{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESPocket Runtime Page declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "appId",
    "rootPageId",
    "pageIds",
    "presentation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "rootPageId": {
      "type": "string",
      "minLength": 1
    },
    "pageIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cardId"
        ],
        "properties": {
          "cardId": {
            "type": "string",
            "minLength": 1
          },
          "targetPageId": {
            "type": "string"
          }
        }
      }
    },
    "backPresentation": {
      "enum": [
        "framework",
        "appOwned"
      ],
      "default": "framework"
    },
    "usesStandardBackControl": {
      "type": "boolean",
      "default": false
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenFlow",
        "transitions"
      ],
      "properties": {
        "screenFlow": {
          "type": "string",
          "minLength": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "action"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
