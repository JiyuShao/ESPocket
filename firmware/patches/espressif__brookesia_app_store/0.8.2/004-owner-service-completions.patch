+class OwnerCompletion : public std::enable_shared_from_this<OwnerCompletion> {
+public:
+    template<class Result, class Handler>
+    auto defer(Handler handler)
+    {
+        return [mailbox = shared_from_this(), handler = std::move(handler)](Result &&result) mutable {
+            std::lock_guard lock(mailbox->mutex_);
+            if (mailbox->closed_) {
+                return;
+            }
+            mailbox->pending_.emplace_back(
+                [handler, result = std::move(result)]() mutable { handler(std::move(result)); });
+        };
+    }
+
+    void enqueue(std::function<void()> handler)
+    {
+        std::lock_guard lock(mutex_);
+        if (!closed_) {
+            pending_.push_back(std::move(handler));
+        }
+    }
+
+    // Both drain and close belong to the App Owner. Never execute user code
+    // while holding the mutex: handlers can submit another async operation.
+    bool drain_one()
+    {
+        std::function<void()> handler;
+        {
+            std::lock_guard lock(mutex_);
+            if (closed_ || pending_.empty()) {
+                return false;
+            }
+            handler = std::move(pending_.front());
+            pending_.pop_front();
+        }
+        handler();
+        return true;
+    }
+
+    void close()
+    {
+        std::lock_guard lock(mutex_);
+        closed_ = true;
+        pending_.clear();
+    }
+
+private:
+    std::mutex mutex_;
+    bool closed_ = false;
+    std::deque<std::function<void()>> pending_;
+};
