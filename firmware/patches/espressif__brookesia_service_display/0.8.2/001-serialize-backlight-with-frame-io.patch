+std::expected<std::shared_ptr<std::mutex>, std::string> Display::get_backlight_draw_mutex(uint32_t output_id)
+{
+    std::lock_guard lock(mutex_);
+    const auto output_it = outputs_.find(output_id);
+    if (output_it == outputs_.end()) {
+        return std::unexpected((boost::format("Display output id %1% is not available") % output_id).str());
+    }
+    if (!output_it->second.draw_mutex) {
+        return std::unexpected("Display output draw mutex is not available");
+    }
+    return output_it->second.draw_mutex;
