+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace esp_brookesia::hal {
+
+// An opt-in acoustic half-duplex gate. Cloud and decoder queue completion are
+// independent of PCM reaching the DAC. Silence from an idle mixer never extends
+// this gate, so local WakeNet remains available after playback ends.
+class PlaybackCaptureGuard {
+public:
+    void configure(uint32_t rate, uint8_t channels, uint8_t bits, uint16_t tail_ms)
+    {
+        bytes_per_second_ = bits == 16 ? static_cast<uint64_t>(rate) * channels * 2 : 0;
+        tail_us_ = static_cast<int64_t>(tail_ms) * 1000;
+        until_us_.store(0, std::memory_order_release);
+    }
+
+    void note_output(const uint8_t *data, int size, int64_t now_us)
+    {
+        if (!data || size <= 0 || bytes_per_second_ == 0 || tail_us_ == 0) return;
+        bool audible = false;
+        for (int offset = 0; offset + 1 < size; offset += 2) {
+            int16_t sample;
+            std::memcpy(&sample, data + offset, sizeof(sample));
+            // Ignore digital idle/dither below -60 dBFS, which cannot form speech.
+            if (sample >= 32 || sample <= -32) { audible = true; break; }
+        }
+        if (!audible) return;
+        const auto duration_us = static_cast<int64_t>((static_cast<uint64_t>(size) * 1000000 +
+                                                        bytes_per_second_ - 1) / bytes_per_second_);
+        const auto deadline = now_us + duration_us + tail_us_;
+        auto previous = until_us_.load(std::memory_order_acquire);
+        while (previous < deadline && !until_us_.compare_exchange_weak(
+                   previous, deadline, std::memory_order_release, std::memory_order_acquire)) {}
+    }
+
+    bool suppresses_capture(int64_t now_us) const
+    {
+        return now_us < until_us_.load(std::memory_order_acquire);
+    }
+
+private:
+    // Configuration is immutable while the audio manager callbacks are active.
+    uint64_t bytes_per_second_ = 0;
+    int64_t tail_us_ = 0;
+    std::atomic<int64_t> until_us_{0};
+};
+
+} // namespace esp_brookesia::hal
