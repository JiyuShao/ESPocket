--- /dev/null
+++ b/src/audio/pcm_gain.hpp
@@ -0,0 +1,113 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace esp_brookesia::hal {
+class BoundedPcmGain {
+public:
+    void configure(uint32_t sample_rate, uint8_t channels, uint8_t bits,
+                   uint16_t gain_percent, uint16_t peak_percent)
+    {
+        enabled_ = bits == 16 && sample_rate >= 8000 && sample_rate <= 48000 &&
+                   channels >= 1 && channels <= 2 && (gain_percent != 100 || peak_percent < 100);
+        channels_ = channels;
+        delay_frames_ = enabled_ ? sample_rate / 200 : 0;
+        maximum_gain_ = static_cast<int32_t>(static_cast<int64_t>(gain_percent) * 65536 / 100);
+        peak_limit_ = 32767 * static_cast<int32_t>(std::min<uint16_t>(peak_percent, 100)) / 100;
+        attack_step_ = enabled_ ? (maximum_gain_ + delay_frames_ - 1) / delay_frames_ : 0;
+        release_step_ = std::max<int32_t>(1, maximum_gain_ / std::max<uint32_t>(1, sample_rate / 10));
+        hold_frames_ = sample_rate / 20 + delay_frames_;
+        reset();
+    }
+
+    void reset()
+    {
+        delayed_.fill(0);
+        cursor_ = 0;
+        gain_ = maximum_gain_;
+        target_gain_ = maximum_gain_;
+        hold_remaining_ = 0;
+        pending_ = false;
+    }
+
+    bool process(uint8_t *data, size_t size)
+    {
+        if (!enabled_) return true;
+        if (!data || size % (channels_ * sizeof(int16_t)) != 0) return false;
+        for (size_t offset = 0; offset < size; offset += channels_ * sizeof(int16_t)) {
+            int32_t peak = 0;
+            std::array<int16_t, 2> incoming{};
+            std::memcpy(incoming.data(), data + offset, channels_ * sizeof(int16_t));
+            for (size_t channel = 0; channel < channels_; ++channel) {
+                peak = std::max(peak, std::abs(static_cast<int32_t>(incoming[channel])));
+            }
+            const auto allowed_gain = peak == 0 ? maximum_gain_ :
+                                      std::min(maximum_gain_, peak_limit_ * 65536 / peak);
+            if (allowed_gain < maximum_gain_) {
+                target_gain_ = std::min(target_gain_, allowed_gain);
+                hold_remaining_ = hold_frames_;
+            } else if (hold_remaining_ > 0) {
+                --hold_remaining_;
+            } else {
+                target_gain_ = std::min(maximum_gain_, target_gain_ + release_step_);
+            }
+            if (gain_ > target_gain_) {
+                gain_ = std::max(target_gain_, gain_ - attack_step_);
+            } else {
+                gain_ = std::min(target_gain_, gain_ + release_step_);
+            }
+            for (size_t channel = 0; channel < channels_; ++channel) {
+                const auto position = cursor_ * channels_ + channel;
+                const auto output = static_cast<int16_t>(static_cast<int64_t>(delayed_[position]) * gain_ / 65536);
+                delayed_[position] = incoming[channel];
+                std::memcpy(data + offset + channel * sizeof(int16_t), &output, sizeof(output));
+            }
+            cursor_ = (cursor_ + 1) % delay_frames_;
+        }
+        pending_ = pending_ || size > 0;
+        return true;
+    }
+
+    size_t flush(uint8_t *data, size_t capacity)
+    {
+        const auto bytes = delay_frames_ * channels_ * sizeof(int16_t);
+        if (!pending_ || !data || capacity < bytes) return 0;
+        std::memset(data, 0, bytes);
+        process(data, bytes);
+        for (size_t frame = 0; frame < delay_frames_; ++frame) {
+            for (size_t channel = 0; channel < channels_; ++channel) {
+                const auto offset = (frame * channels_ + channel) * sizeof(int16_t);
+                int16_t sample;
+                std::memcpy(&sample, data + offset, sizeof(sample));
+                sample = static_cast<int16_t>(static_cast<int32_t>(sample) *
+                                              static_cast<int32_t>(delay_frames_ - frame - 1) /
+                                              static_cast<int32_t>(delay_frames_));
+                std::memcpy(data + offset, &sample, sizeof(sample));
+            }
+        }
+        reset();
+        return bytes;
+    }
+
+private:
+    std::array<int16_t, 480> delayed_{};
+    size_t cursor_ = 0;
+    size_t delay_frames_ = 0;
+    uint8_t channels_ = 0;
+    int32_t maximum_gain_ = 65536;
+    int32_t peak_limit_ = 32767;
+    int32_t attack_step_ = 0;
+    int32_t release_step_ = 1;
+    int32_t gain_ = 65536;
+    int32_t target_gain_ = 65536;
+    uint32_t hold_frames_ = 0;
+    uint32_t hold_remaining_ = 0;
+    bool enabled_ = false;
+    bool pending_ = false;
+};
+}
