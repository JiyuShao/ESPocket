--- /dev/null
+++ b/src/audio/pcm_gain.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace esp_brookesia::hal {
+inline void apply_bounded_pcm_gain(uint8_t *data, size_t size, uint16_t gain_percent, uint16_t peak_percent = 100)
+{
+    if (!data || size % sizeof(int16_t) != 0 || (gain_percent <= 100 && peak_percent >= 100)) return;
+    int32_t peak = 0;
+    for (size_t offset = 0; offset < size; offset += sizeof(int16_t)) {
+        int16_t sample;
+        std::memcpy(&sample, data + offset, sizeof(sample));
+        const auto magnitude = sample < 0 ? -static_cast<int32_t>(sample) : static_cast<int32_t>(sample);
+        if (magnitude > peak) peak = magnitude;
+    }
+    if (peak == 0) return;
+    int32_t numerator = gain_percent > 100 ? gain_percent : 100;
+    int32_t denominator = 100;
+    const auto peak_limit = 32767 * static_cast<int32_t>(peak_percent < 100 ? peak_percent : 100) / 100;
+    if (peak * numerator > peak_limit * denominator) {
+        numerator = peak_limit;
+        denominator = peak;
+    }
+    for (size_t offset = 0; offset < size; offset += sizeof(int16_t)) {
+        int16_t sample;
+        std::memcpy(&sample, data + offset, sizeof(sample));
+        sample = static_cast<int16_t>(static_cast<int32_t>(sample) * numerator / denominator);
+        std::memcpy(data + offset, &sample, sizeof(sample));
+    }
+}
+}
