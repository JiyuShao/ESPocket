--- /dev/null
+++ b/src/audio/software_aec_reference.hpp
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace esp_brookesia::hal {
+// Diagnostic software reference. Timestamps approximate DAC/ADC sample time;
+// device correlation must calibrate delay before enabling a product default.
+class SoftwareAecReference {
+public:
+    bool configure(bool enabled, uint32_t rate, uint8_t channels, uint8_t bits, uint16_t delay_ms)
+    {
+        enabled_ = false;
+        samples_.clear();
+        if (!enabled) return true;
+        if (rate != 16000 || channels != 2 || bits != 16 || delay_ms > 250) return false;
+        rate_ = rate;
+        delay_samples_ = static_cast<int64_t>(rate) * delay_ms / 1000;
+        try { samples_.resize(rate / 2); } catch (...) { return false; } // Bounded 500 ms history, allocated before callbacks.
+        enabled_ = true;
+        return true;
+    }
+    void record_output(const uint8_t *data, int size, int64_t first_sample_us)
+    {
+        if (!enabled_ || !data || size <= 0 || size % 4) return;
+        std::lock_guard lock(mutex_);
+        const auto first = sample_index(first_sample_us);
+        for (int frame = 0; frame < size / 4; ++frame) {
+            auto index = first + frame;
+            if (index < 0) continue;
+            auto &sample = samples_[static_cast<size_t>(index) % samples_.size()];
+            sample.index = index;
+            // This board's ES8311 uses the left output slot; do not average slots.
+            std::memcpy(&sample.pcm, data + frame * 4, 2);
+        }
+    }
+    void invalidate()
+    {
+        if (!enabled_) return;
+        std::lock_guard lock(mutex_);
+        for (auto &sample : samples_) sample.index = -1;
+    }
+    bool inject_reference(uint8_t *data, int size, int64_t capture_end_us)
+    {
+        if (!enabled_) return true;
+        if (!data || size <= 0 || size % 4) return false;
+        std::lock_guard lock(mutex_);
+        const auto first = sample_index(capture_end_us) - size / 4 - delay_samples_;
+        for (int frame = 0; frame < size / 4; ++frame) {
+            const auto index = first + frame;
+            int16_t reference = 0;
+            if (index >= 0) {
+                const auto &sample = samples_[static_cast<size_t>(index) % samples_.size()];
+                if (sample.index == index) reference = sample.pcm;
+            }
+            // Channel zero remains the microphone; channel one becomes reference.
+            std::memcpy(data + frame * 4 + 2, &reference, 2);
+        }
+        return true;
+    }
+private:
+    struct Sample { int64_t index = -1; int16_t pcm = 0; };
+    int64_t sample_index(int64_t us) const { return us / 1000000 * rate_ + us % 1000000 * rate_ / 1000000; }
+    bool enabled_ = false;
+    uint32_t rate_ = 0;
+    int64_t delay_samples_ = 0;
+    std::mutex mutex_;
+    std::vector<Sample> samples_;
+};
+}
