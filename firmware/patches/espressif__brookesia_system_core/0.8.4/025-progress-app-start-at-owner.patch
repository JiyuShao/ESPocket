+void System::Impl::report_app_start_failure(AppRecord &record, const std::string &error, AppStartFailureKind kind)
+{
+    owner_.on_app_start_failed(record.info, error);
+    if (kind == AppStartFailureKind::Admission) {
+        show_app_admission_error_dialog(owner_, record.info, error == "developer_mode_required" ?
+            "Enable Developer Mode to run this app. Installed content is retained." : error);
+    } else {
+        show_lifecycle_error_dialog(owner_, record.info, "start", LIFECYCLE_ON_START, error);
+    }
+}
+
+std::expected<void, std::string> System::Impl::admit_app_start(AppRecord &record)
+{
+    if (record.info.manifest.kind != AppKind::Runtime) return {};
+    if (package_policy_.enforce) {
+        const auto started_at = SteadyClock::now();
+        auto admitted = validate_installed_runtime_package(record.info.manifest.app_path, owner_.get_system_type(), package_policy_);
+        SYSTEM_CORE_PROFILE_LOGI(
+            "App start profile: id(%1%), manifest(%2%), stage(package_admission), elapsed_ms(%3%)",
+            record.info.app_id, record.info.manifest.id, elapsed_ms_since(started_at));
+        if (!admitted) return std::unexpected(admitted.error());
+    }
+    // Preserve synchronous start_app's admission check for an already-running
+    // Runtime App, without rechecking services used by that running instance.
+    if (record.info.state == AppState::Running) return {};
+    const auto failures = detail::evaluate_service_requirements(record.info.manifest, service::ServiceManager::get_instance());
+    for (const auto &failure : failures) {
+        const auto local_version = failure.registered ? failure.local_version : "<none>";
+        BROOKESIA_LOGW(
+            "App service requirement failed: phase(start), app_id(%1%), manifest(%2%), rpc(%3%), "
+            "required_version(%4%), local_version(%5%), reason(%6%)",
+            record.info.app_id, record.info.manifest.id, failure.requirement.name,
+            failure.requirement.version, local_version, failure.reason);
+    }
+    if (!failures.empty()) return std::unexpected(detail::format_service_requirement_failures(failures));
+    return {};
+}
+
+std::expected<void, std::string> System::Impl::start_app_runtime(AppRecord &record)
+{
+    if (record.info.manifest.kind != AppKind::Runtime || record.runtime_started) return {};
+    auto result = runtime_->start_app(*record.runtime_app_id);
+    record.runtime_started = result.has_value();
+    return result;
+}
+
+std::expected<void, std::string> System::Impl::call_app_start(AppRecord &record)
+{
+    if (record.info.manifest.kind == AppKind::Runtime) return call_runtime_lifecycle(record, LIFECYCLE_ON_START);
+    if (!record.native_app || !record.context) return std::unexpected("Native app is not available");
+    return record.native_app->on_start(*record.context);
+}
+
+std::expected<void, std::string> System::Impl::commit_app_start(AppRecord &record)
+{
+    record.info.state = AppState::Running;
+    active_app_id_ = record.info.app_id;
+    return owner_.on_app_started(record.info);
+}
+
+void System::Impl::release_app_start_runtime(AppRecord &record)
+{
+    detail::release_runtime_dataflow_operations(record.runtime_app_id);
+    if (record.info.manifest.kind == AppKind::Runtime) unload_runtime(record);
+}
+
+void System::Impl::rollback_app_start_gui(AppRecord &record)
+{
+    clear_pending_gui_bindings(record.info.app_id);
+    unload_gui(record);
+    unregister_app_gui_resources(record);
+}
