+#include "brookesia/system_core/macro_configs.h"
+#include "private/utils.hpp"
+#include <chrono>
+#include "brookesia/lib_utils/function_guard.hpp"
+#include "private/system/impl.hpp"
+
+namespace esp_brookesia::system::core {
+std::expected<void, std::string> System::request_app_start(AppId app_id)
+{
+    if (impl_->should_schedule_app_task()) {
+        return impl_->run_task_sync<std::expected<void, std::string>>(
+            SYSTEM_APP_TASK_GROUP, [this, app_id]() { return request_app_start(app_id); },
+            std::unexpected("Failed to post app start request"));
+    }
+    auto found = impl_->get_record(app_id);
+    if (!found) return std::unexpected(found.error());
+    auto &record = **found;
+    if (record.pending_start) return record.pending_start->cancelled ?
+        std::expected<void, std::string>(std::unexpected("app_start_cancelling")) : std::expected<void, std::string>{};
+    for (const auto &[_, other] : impl_->apps_) {
+        if (other.pending_start) return std::unexpected("another_app_start_in_progress");
+    }
+    if (record.info.state == AppState::Running) return {};
+    if (record.info.state == AppState::Paused || record.info.state == AppState::Stopping || record.info.state == AppState::Starting)
+        return std::unexpected("app_state_not_startable");
+    if (!impl_->task_scheduler_ || !impl_->task_scheduler_->is_running())
+        return std::unexpected("app_scheduler_unavailable");
+    record.pending_start = std::make_shared<Impl::PendingAppStart>();
+    record.info.state = AppState::Starting;
+    record.info.last_error.clear();
+    return {};
+}
+
+void System::Impl::advance_app_starts(bool drain)
+{
+    if (advancing_app_starts_) return;
+    advancing_app_starts_ = true;
+    struct ProgressGuard { bool &active; ~ProgressGuard() { active = false; } } guard{advancing_app_starts_};
+    using Phase = PendingAppStart::Phase;
+    for (auto &[id, record] : apps_) {
+        auto start = record.pending_start;
+        if (!start) continue;
+        if (drain) start->cancelled = true;
+        do {
+#if BROOKESIA_SYSTEM_CORE_ENABLE_PROFILE_LOG
+            const auto phase = start->phase;
+            const auto phase_started = std::chrono::steady_clock::now();
+            const auto manifest_id = record.info.manifest.id;
+            lib_utils::FunctionGuard phase_profile([&, manifest_id]() {
+                const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now() - phase_started).count();
+                // Do not log every nonblocking future poll. Record actual phase
+                // transitions and unexpectedly long Owner occupancy.
+                if (phase == start->phase &&
+                        (phase == Phase::GuiWait || phase == Phase::RollbackWait) && elapsed < 250) return;
+                static constexpr const char *names[] = {
+                    "admission", "gui_dispatch", "gui_wait", "runtime_load", "runtime_start",
+                    "lifecycle", "commit", "rollback", "rollback_wait"
+                };
+                BROOKESIA_LOGI("App start phase: app(%1%), phase(%2%), owner_ms(%3%), cancelled(%4%)",
+                    manifest_id, names[static_cast<size_t>(phase)], elapsed, start->cancelled);
+            });
+#endif
+            if (start->cancelled && start->phase != Phase::GuiWait && start->phase != Phase::RollbackWait)
+                start->phase = Phase::Rollback;
+            std::expected<void, std::string> result;
+            auto post_gui = [&](bool rollback) {
+                auto promise = std::make_shared<boost::promise<std::expected<void, std::string>>>();
+                start->gui_result = promise->get_future();
+                auto work = [this, promise, record_ptr = &record, rollback]() {
+                    try {
+                        if (rollback) {
+                            rollback_app_start_gui(*record_ptr);
+                            promise->set_value({});
+                        } else promise->set_value(prepare_app_start_gui(*record_ptr));
+                    } catch (...) { promise->set_exception(boost::current_exception()); }
+                };
+                if (drain || !task_scheduler_ || !task_scheduler_->is_running()) {
+                    execute_task_with_group_context(SYSTEM_GUI_TASK_GROUP, std::move(work));
+                    return true;
+                }
+                return static_cast<bool>(task_scheduler_->post(std::move(work), nullptr, SYSTEM_GUI_TASK_GROUP));
+            };
+            const auto attempted_phase = start->phase;
+            try {
+            switch (start->phase) {
+            case Phase::Admission:
+                result = admit_app_start(record);
+                start->phase = Phase::GuiDispatch;
+                break;
+            case Phase::GuiDispatch:
+                if (!post_gui(false)) result = std::unexpected("Failed to post app GUI preparation");
+                else start->phase = Phase::GuiWait;
+                break;
+            case Phase::GuiWait:
+            case Phase::RollbackWait:
+                if (!drain && start->gui_result.wait_for(boost::chrono::milliseconds(0)) != boost::future_status::ready) break;
+                try { result = start->gui_result.get(); }
+                catch (const std::exception &error) { result = std::unexpected(error.what()); }
+                catch (...) { result = std::unexpected("App GUI preparation exception"); }
+                if (start->phase == Phase::RollbackWait) {
+                    if (!result) {
+                        record.info.last_error = result.error();
+                        start->phase = Phase::Rollback;
+                        return; // Retain cleanup ownership; next Owner tick retries rollback.
+                    }
+                    record.pending_start.reset();
+                    if (active_app_id_ == id) active_app_id_ = INVALID_APP_ID;
+                    record.info.state = start->cancelled && start->stop_error.empty() ? AppState::Stopped : AppState::Error;
+                    record.info.last_error = start->stop_error.empty() ? start->error : start->stop_error;
+                    if (start->cancelled && !start->stop_error.empty()) owner_.on_app_stop_failed(record.info, start->stop_error);
+                    else if (start->cancelled) owner_.on_app_stopped(record.info);
+                    else report_app_start_failure(record, start->error, start->failure_kind);
+                    break;
+                }
+                start->phase = start->cancelled ? Phase::Rollback : Phase::RuntimeLoad;
+                break;
+            case Phase::RuntimeLoad:
+                if (record.info.manifest.kind == AppKind::Runtime) result = ensure_runtime_loaded(record);
+                start->phase = Phase::RuntimeStart;
+                break;
+            case Phase::RuntimeStart:
+                result = start_app_runtime(record);
+                start->phase = Phase::Lifecycle;
+                break;
+            case Phase::Lifecycle:
+                start->callback_attempted = true;
+                result = call_app_start(record);
+                start->phase = Phase::Commit;
+                break;
+            case Phase::Commit:
+                result = commit_app_start(record);
+                if (result) record.pending_start.reset();
+                break;
+            case Phase::Rollback:
+                cleanup_app_transient_resources(record);
+                if (start->callback_attempted) {
+                    start->callback_attempted = false;
+                    try {
+                        std::expected<void, std::string> stopped;
+                        if (record.info.manifest.kind == AppKind::Runtime) stopped = call_runtime_lifecycle(record, LIFECYCLE_ON_STOP);
+                        else if (record.native_app && record.context) stopped = record.native_app->on_stop(*record.context);
+                        if (!stopped) start->stop_error = stopped.error();
+                    } catch (const std::exception &error) { start->stop_error = error.what(); }
+                    catch (...) { start->stop_error = "App stop exception during startup rollback"; }
+                }
+                release_app_start_runtime(record);
+                if (!post_gui(true)) {
+                    record.info.last_error = "Failed to post app GUI rollback";
+                    return; // Keep the record pinned until a later tick can clean it.
+                }
+                start->phase = Phase::RollbackWait;
+                break;
+            }
+            } catch (const std::exception &error) { result = std::unexpected(error.what()); }
+            catch (...) { result = std::unexpected("App startup exception"); }
+            if (!result) {
+                if (attempted_phase == Phase::Admission) start->failure_kind = AppStartFailureKind::Admission;
+                start->error = result.error();
+                start->phase = Phase::Rollback;
+            }
+            if (!record.pending_start) break;
+        } while (drain);
+    }
+}
