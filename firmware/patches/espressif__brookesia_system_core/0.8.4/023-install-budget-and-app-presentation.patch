+std::expected<uint64_t, std::string> private_data_allocation(const std::filesystem::path &directory)
+{
+    using Storage = service::helper::Storage;
+    std::vector<std::filesystem::path> pending{directory / "data", directory / "cache", directory / "files"};
+    uint64_t allocation = 0;
+    size_t visited = 0;
+    while (!pending.empty()) {
+        const auto path = std::move(pending.back()); pending.pop_back();
+        if (++visited > 8192) return std::unexpected("private_data_budget_limit");
+        auto info = Storage::fs_stat(path.generic_string(), STORAGE_FS_TIMEOUT_MS);
+        if (!info) return std::unexpected(info.error());
+        if (!info->exists) continue;
+        if (info->type == Storage::FileType::File) {
+            allocation += ((info->size + 4095) / 4096 + 1) * 4096;
+        } else if (info->type == Storage::FileType::Directory) {
+            allocation += 8192;
+            auto entries = Storage::fs_list(path.generic_string(), STORAGE_FS_TIMEOUT_MS);
+            if (!entries) return std::unexpected(entries.error());
+            for (const auto &entry : *entries) {
+                if (!is_safe_app_directory_name(entry.name)) return std::unexpected("invalid_private_data_path");
+                pending.push_back(path / entry.name);
+            }
+        } else return std::unexpected("invalid_private_data_type");
+    }
+    return allocation;
+}
