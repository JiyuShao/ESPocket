+std::expected<void, std::string> check_install_space(const std::filesystem::path &root, uint64_t required)
+{
+    using Storage = service::helper::Storage;
+    auto filesystems = Storage::call_function_sync<boost::json::array>(Storage::FunctionId::GetFileSystems, service::helper::Timeout(3000));
+    if (!filesystems) return std::unexpected("install_capacity_unavailable");
+    std::string selected;
+    size_t best = 0;
+    const auto destination = root.lexically_normal().generic_string();
+    for (const auto &value : *filesystems) {
+        if (!value.is_object()) continue;
+        const auto &object = value.as_object();
+        auto field = [&](const char *key) {
+            const auto found = object.find(key);
+            return found != object.end() && found->value().is_string() ? std::string(found->value().as_string().c_str()) : std::string{};
+        };
+        const auto mount = field("mount_point");
+        auto volume_root = field("root_path");
+        if (volume_root.empty()) volume_root = mount;
+        for (const auto &path : {volume_root, mount}) {
+            if (path.empty()) continue;
+            const auto prefix = std::filesystem::path(path).lexically_normal().generic_string();
+            if ((prefix == "/" || destination == prefix || destination.starts_with(prefix + "/")) && prefix.size() > best) {
+                best = prefix.size(); selected = mount;
+            }
+        }
+    }
+    if (selected.empty()) return std::unexpected("install_capacity_unavailable");
+    auto capacity = Storage::call_function_sync<boost::json::object>(Storage::FunctionId::GetFileSystemCapacity, selected, service::helper::Timeout(3000));
+    if (!capacity) return std::unexpected("install_capacity_unavailable");
+    const auto free = capacity->find("free_bytes");
+    if (free == capacity->end() || (!free->value().is_uint64() && !free->value().is_int64()))
+        return std::unexpected("install_capacity_unavailable");
+    const uint64_t available = free->value().is_uint64() ? free->value().as_uint64() :
+        static_cast<uint64_t>(std::max<int64_t>(0, free->value().as_int64()));
+    if (available < required + 256 * 1024) return std::unexpected("insufficient_install_space");
+    return {};
+}
