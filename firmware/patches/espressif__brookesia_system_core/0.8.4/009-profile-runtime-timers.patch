+namespace {
+int64_t timer_probe_now()
+{
+    return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+struct TimerProbe {
+    bool enabled;
+    int64_t next_due, interval_us, window_start=timer_probe_now(), last_dispatch=0;
+    uint64_t callbacks=0, wake_us=0, wake_max_us=0, queue_us=0, queue_max_us=0,
+        callback_us=0, callback_max_us=0, period_us=0, period_max_us=0, periods=0;
+    std::atomic<uint32_t> coalesced{0};
+    void record(AppId app, std::string_view name, int64_t enqueued, uint64_t wake_delay, int64_t start, int64_t end) {
+        if (!enabled) return;
+        const auto queued=static_cast<uint64_t>(std::max<int64_t>(0,start-enqueued));
+        const auto elapsed=static_cast<uint64_t>(std::max<int64_t>(0,end-start));
+        ++callbacks;wake_us+=wake_delay;wake_max_us=std::max(wake_max_us,wake_delay);
+        queue_us+=queued;queue_max_us=std::max(queue_max_us,queued);
+        callback_us+=elapsed;callback_max_us=std::max(callback_max_us,elapsed);
+        if(last_dispatch){const auto period=static_cast<uint64_t>(start-last_dispatch);++periods;period_us+=period;period_max_us=std::max(period_max_us,period);}
+        last_dispatch=start;
+        if (end-window_start<2000000) return;
+        BROOKESIA_LOGI("Runtime timer profile: app(%1%), name(%2%), window_us(%3%), requested_us(%4%), callbacks(%5%), coalesced(%6%), wake_total_us(%7%), wake_max_us(%8%), queue_total_us(%9%), queue_max_us(%10%), callback_total_us(%11%), callback_max_us(%12%), periods(%13%), period_total_us(%14%), period_max_us(%15%)",
+            app,name,end-window_start,interval_us,callbacks,coalesced.exchange(0),wake_us,wake_max_us,queue_us,queue_max_us,callback_us,callback_max_us,periods,period_us,period_max_us);
+        window_start=end;callbacks=wake_us=wake_max_us=queue_us=queue_max_us=callback_us=callback_max_us=period_us=period_max_us=periods=0;
+    }
+};
+}
+#endif
 
