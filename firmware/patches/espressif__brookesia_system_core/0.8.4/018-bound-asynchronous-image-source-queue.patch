+std::expected<void, std::string> System::Impl::enqueue_gui_image_source(
+    AppId app_id, std::string_view path, std::string_view src)
+{
+    auto record = get_record(app_id);
+    if (!record || !gui_runtime_ || !record.value()->document_id.has_value()) {
+        return std::unexpected("App GUI document is not loaded");
+    }
+    if (!task_scheduler_ || !task_scheduler_->is_running()) {
+        return std::unexpected("System GUI scheduler is not available");
+    }
+    // SetViewSrc retains the upstream asynchronous submission contract. Bound
+    // both commands and bytes instead of making the App wait for drawing.
+    constexpr size_t MAX_COMMANDS = 8;
+    constexpr size_t MAX_BYTES = 32 * 1024;
+    if (path.size() > MAX_BYTES || src.size() > MAX_BYTES - path.size()) {
+        return std::unexpected("GUI image source exceeds queue byte budget");
+    }
+    const auto bytes = path.size() + src.size();
+    std::lock_guard lock(gui_image_source_mutex_);
+    auto &slot = pending_gui_image_sources_[app_id];
+    if (!slot || slot->document_id != *record.value()->document_id) {
+        if (slot) { slot->active = false; slot->commands.clear(); }
+        slot = std::make_shared<PendingImageSources>();
+        slot->document_id = *record.value()->document_id;
+    }
+    auto buffer = slot;
+    if (buffer->commands.size() >= MAX_COMMANDS || bytes > MAX_BYTES - buffer->bytes) {
+        return std::unexpected("GUI image source queue is full");
+    }
+    buffer->commands.emplace_back(path, src);
+    buffer->bytes += bytes;
+    if (!buffer->scheduled) {
+        // Scheduler::post always enqueues; it cannot run this closure inline
+        // while the buffer mutex is held. At most one successor is queued
+        // while the current GUI owner applies its finite ordered batch.
+        if (!task_scheduler_->post([this, app_id, buffer]() {
+            flush_gui_image_sources(app_id, buffer);
+        }, nullptr, SYSTEM_GUI_INPUT_TASK_GROUP)) {
+            buffer->commands.pop_back();
+            buffer->bytes -= bytes;
+            return std::unexpected("Failed to post GUI image source task");
+        }
+        buffer->scheduled = true;
+    }
+    return {};
+}
+
+void System::Impl::flush_gui_image_sources(AppId app_id, std::shared_ptr<PendingImageSources> buffer)
+{
+    std::vector<std::pair<std::string, std::string>> commands;
+    {
+        std::lock_guard lock(gui_image_source_mutex_);
+        if (!buffer->active) return;
+        commands.swap(buffer->commands);
+        buffer->bytes = 0;
+        buffer->scheduled = false;
+    }
+    auto record = get_record(app_id);
+    if (!record || !gui_runtime_ || record.value()->document_id != buffer->document_id) return;
+    flush_pending_gui_bindings(app_id);
+    for (const auto &[path, src] : commands) {
+        if (!gui_runtime_->set_view_src(buffer->document_id, path, src)) {
+            // As upstream, acceptance is not a promise of deferred rendering
+            // success. Report invalid sources at their actual GUI owner.
+            BROOKESIA_LOGW("Failed to set GUI image source: app_id(%1%), path(%2%)", app_id, path);
+        }
+    }
+}
+
+void System::Impl::clear_pending_gui_image_sources(AppId app_id)
+{
+    std::lock_guard lock(gui_image_source_mutex_);
+    auto found = pending_gui_image_sources_.find(app_id);
+    if (found == pending_gui_image_sources_.end()) return;
+    found->second->active = false;
+    found->second->commands.clear();
+    pending_gui_image_sources_.erase(found);
+}
+
+void System::Impl::clear_all_pending_gui_image_sources()
+{
+    std::lock_guard lock(gui_image_source_mutex_);
+    for (auto &[app_id, buffer] : pending_gui_image_sources_) {
+        (void)app_id;
+        buffer->active = false;
+        buffer->commands.clear();
+    }
+    pending_gui_image_sources_.clear();
+}
