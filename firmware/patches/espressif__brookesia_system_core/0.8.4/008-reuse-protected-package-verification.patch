+using Storage = service::helper::Storage;
+bool within(const fs::path &path, const fs::path &root)
+{
+    auto p = path.begin(), r = root.begin();
+    for (; r != root.end(); ++r, ++p) if (p == path.end() || *p != *r) return false;
+    return true;
+}
+bool private_path(const fs::path &relative)
+{
+    auto it = relative.begin();
+    if (it == relative.end()) return false;
+    const auto first = it->string();
+    return first == "data" || first == "cache" || first == "files";
+}
+std::string text_field(const boost::json::object &object, const char *name)
+{
+    auto *v = object.if_contains(name);
+    return v && v->is_string() ? std::string(v->as_string()) : "";
+}
+std::string configuration_key(const RuntimePackagePolicy &policy)
+{
+    boost::json::object builtins;
+    for (const auto &[id, members] : policy.built_in_members) {
+        boost::json::object values;
+        for (const auto &[path, hash] : members) values[path] = hash;
+        builtins[id] = std::move(values);
+    }
+    return boost::json::serialize(boost::json::object{
+        {"format", FORMAT}, {"baseline", policy.platform_baseline},
+        {"key_path", policy.public_key_pem_path}, {"enforce", policy.enforce},
+        {"builtins", std::move(builtins)}});
+}
