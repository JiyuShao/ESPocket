+constexpr const char *SEAL = ".brookesia-verified.json";
+constexpr const char *TEMP = ".brookesia-verified.pending";
+constexpr const char *FORMAT = "core.package.validation.v2";
+constexpr const char *OWNER = "core.package.write_owner";
+constexpr const char *KIND = "core.package.write_kind";
+constexpr const char *EPOCH = "core.package.write_epoch";
