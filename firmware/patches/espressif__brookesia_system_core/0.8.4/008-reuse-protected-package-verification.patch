+void profile_validation(std::string_view path, const char *source)
+{
+#if BROOKESIA_SYSTEM_CORE_ENABLE_PROFILE_LOG
+    BROOKESIA_LOGI("Package validation profile: path(%1%), source(%2%)", path, source);
+#else
+    (void)path; (void)source;
+#endif
