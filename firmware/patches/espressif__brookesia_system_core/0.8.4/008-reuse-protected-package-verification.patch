+
+struct PackageValidationState {
+    std::mutex mutex, key_mutex;
+    std::vector<fs::path> roots;
+    fs::path key_path;
+    std::string owner, configuration, key_digest, binding, seal_key;
+    bool key_loaded = false;
+    uint64_t epoch = 0;
+    std::map<std::string, PackageAdmission> admissions;
+};
+
+namespace {
+// Runs on Storage's internal-RAM worker before any write side effect. The
+// framework captures CallContext with each queued service operation.
+std::expected<void, std::string> before_mutation(
+    const std::shared_ptr<PackageValidationState> &state,
+    const fs::path &path, const service::CallContext &context)
+{
+    std::vector<fs::path> packages;
+    bool protected_path = false, trust_change = false;
+    for (const auto &root : state->roots) {
+        if (within(root, path)) {
+            protected_path = true;
+            std::error_code error;
+            const bool exists = fs::exists(root, error);
+            if (error) return std::unexpected("package_verification_invalidation_failed");
+            if (exists) {
+                fs::directory_iterator iterator(root, error);
+                if (error) return std::unexpected("package_verification_invalidation_failed");
+                for (const auto &entry : iterator) {
+                    if (!entry.path().filename().string().starts_with('.')) packages.push_back(entry.path());
+                }
+            }
+        } else if (within(path, root)) {
+            const auto relative = path.lexically_relative(root);
+            auto first = relative.begin();
+            if (first == relative.end()) continue;
+            const auto package = root / *first;
+            if (!first->string().starts_with('.') && private_path(path.lexically_relative(package))) continue;
+            protected_path = true;
+            // Staging/rollback never carry reusable committed records. Their
+            // promotions invalidate the ordinary destination before mutation.
+            if (!first->string().starts_with('.')) packages.push_back(package);
+        }
+    }
+    if (!state->key_path.empty() && (within(path, state->key_path) || within(state->key_path, path))) {
+        protected_path = true;
+        trust_change = true;
+    }
+    if (!protected_path) return {};
+    auto owner = context.find(OWNER), kind = context.find(KIND);
+    if (owner == context.end() || owner->second != state->owner || kind == context.end())
+        return std::unexpected("package_content_read_only");
+    std::lock_guard lock(state->mutex);
+    if (kind->second == "verification") {
+        auto epoch = context.find(EPOCH);
+        if (trust_change || (path.filename() != SEAL && path.filename() != TEMP) ||
+            epoch == context.end() || epoch->second != std::to_string(state->epoch))
+            return std::unexpected("package_verification_changed");
+        return {};
+    }
+    if (kind->second != "mutation") return std::unexpected("package_content_read_only");
+    ++state->epoch;
+    if (trust_change) {
+        for (const auto &[known, unused] : state->admissions) packages.emplace_back(known);
+        state->key_loaded = false;
+        state->key_digest.clear();
+    }
+    // Invalidate RAM first. Deleting the committed seal durably precedes the
+    // requested mutation; failure blocks that mutation even if RAM was cleared.
+    if (trust_change) state->admissions.clear();
+    else for (const auto &package : packages) state->admissions.erase(package.generic_string());
+    for (const auto &package : packages) {
+        for (const auto *name : {SEAL, TEMP}) {
+            std::error_code error;
+            fs::remove(package / name, error);
+            if (error) return std::unexpected("package_verification_invalidation_failed: " + error.message());
+        }
+    }
+    return {};
+}
+
+std::string hex_bytes(const unsigned char *bytes, size_t size)
+{
+    constexpr char digits[] = "0123456789abcdef";
+    std::string result;
+    result.reserve(size * 2);
+    for (size_t i = 0; i < size; ++i) {
+        result.push_back(digits[bytes[i] >> 4]);
+        result.push_back(digits[bytes[i] & 15]);
+    }
+    return result;
+}
+std::expected<std::string, std::string> seal_mac(std::string_view key, const boost::json::object &record)
+{
+    // RFC 2104 HMAC-SHA256 using the digest API present in mbedTLS 4.
+    // The generated 64-byte hex key exactly fills SHA256's 64-byte block.
+    if (key.size() != 64) return std::unexpected("invalid_package_verification_key");
+    std::string inner(64, '\x36'), outer(64, '\x5c');
+    for (size_t i = 0; i < 64; ++i) {
+        inner[i] ^= key[i]; outer[i] ^= key[i];
+    }
+    inner += boost::json::serialize(record);
+    unsigned char result[32];
+    const auto *algorithm = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (!algorithm || mbedtls_md(algorithm, reinterpret_cast<const unsigned char *>(inner.data()), inner.size(), result) != 0)
+        return std::unexpected("package_verification_mac_failed");
+    outer.append(reinterpret_cast<const char *>(result), sizeof(result));
+    if (mbedtls_md(algorithm, reinterpret_cast<const unsigned char *>(outer.data()), outer.size(), result) != 0)
+        return std::unexpected("package_verification_mac_failed");
+    return hex_bytes(result, sizeof(result));
+}
+std::expected<void, std::string> load_seal_key(const RuntimePackagePolicy &policy)
+{
+    auto state = policy.validation_state;
+    std::lock_guard key_lock(state->key_mutex);
+    {
+        std::lock_guard lock(state->mutex);
+        if (!state->seal_key.empty()) return {};
+    }
+    auto context = service::get_current_call_context();
+    context[OWNER] = state->owner;
+    service::ScopedCallContext guard(std::move(context));
+    auto values = Storage::call_function_sync<boost::json::object>(
+        Storage::FunctionId::KVGet, std::string(KEY_NAMESPACE), boost::json::array{"seal_key"}, service::helper::Timeout(TIMEOUT));
+    if (!values) return std::unexpected("package_verification_key_unavailable");
+    auto key = text_field(*values, "seal_key");
+    if (values->contains("seal_key") && (key.size() != 64 ||
+        key.find_first_not_of("0123456789abcdef") != std::string::npos))
+        return std::unexpected("invalid_package_verification_key");
+    if (key.empty()) {
+        unsigned char random[32];
+#if defined(ESP_PLATFORM)
+        esp_fill_random(random, sizeof(random));
+#else
+        std::random_device source;
+        for (auto &byte : random) byte = static_cast<unsigned char>(source());
+#endif
+        key = hex_bytes(random, sizeof(random));
+        auto written = Storage::call_function_sync<void>(Storage::FunctionId::KVSet,
+            std::string(KEY_NAMESPACE), boost::json::object{{"seal_key", key}}, service::helper::Timeout(TIMEOUT));
+        if (!written) return std::unexpected("package_verification_key_persistence_failed");
+    }
+    std::lock_guard lock(state->mutex);
+    state->seal_key = std::move(key);
+    return {};
+}
+
+std::expected<std::string, std::string> fingerprint(
+    const RuntimePackagePolicy &policy, std::string_view system)
+{
+    const auto state = policy.validation_state;
+    auto key = load_seal_key(policy);
+    if (!key) return std::unexpected(key.error());
+    const auto config = configuration_key(policy);
+    bool load_key;
+    uint64_t epoch;
+    {
+        std::lock_guard lock(state->mutex);
+        if (state->configuration != config) {
+            state->configuration = config;
+            state->key_path = policy.public_key_pem_path;
+            state->key_loaded = false;
+            state->admissions.clear();
+            ++state->epoch;
+        }
+        load_key = !state->key_loaded;
+        epoch = state->epoch;
+    }
+    if (load_key) {
+        std::string material = "no-release-key";
+        if (!policy.public_key_pem_path.empty()) {
+            auto stat = Storage::fs_stat(policy.public_key_pem_path, TIMEOUT);
+            if (!stat) return std::unexpected(stat.error());
+            if (stat->exists) {
+                if (stat->type != Storage::FileType::File || stat->size > 64 * 1024)
+                    return std::unexpected("invalid_package_trust_key");
+                auto key = Storage::fs_read_text(policy.public_key_pem_path, TIMEOUT);
+                if (!key) return std::unexpected(key.error());
+                material = *key;
+            } else material = "release-key-missing";
+        }
+        auto digest = detail::package_validation_digest(material);
+        if (!digest) return std::unexpected(digest.error());
+        std::lock_guard lock(state->mutex);
+        if (epoch != state->epoch) return std::unexpected("package_verification_changed");
+        state->key_digest = *digest;
+        state->key_loaded = true;
+    }
+    std::lock_guard lock(state->mutex);
+    auto result = detail::package_validation_digest(config + std::string(system) + state->key_digest);
+    if (!result) return std::unexpected(result.error());
+    if (state->binding != *result) {
+        state->admissions.clear();
+        state->binding = *result;
+        ++state->epoch;
+    }
+    return result;
+}
