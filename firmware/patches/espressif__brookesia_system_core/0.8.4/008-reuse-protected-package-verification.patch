+            return std::unexpected("invalid_package_verification_member");
+        admission.members.emplace(std::string(name), std::string(hash.as_string()));
+    }
+    auto found = admission.members.find("manifest.json");
+    if (found == admission.members.end() || found->second != *digest)
+        return std::unexpected("package_verification_manifest_mismatch");
+    return admission;
+}
+
+std::expected<void, std::string> write_seal(
+    const fs::path &directory, const PackageAdmission &admission,
+    const RuntimePackagePolicy &policy, std::string_view binding, uint64_t epoch)
+{
+    auto manifest = Storage::fs_read_text((directory / "manifest.json").generic_string(), TIMEOUT);
+    if (!manifest) return std::unexpected(manifest.error());
+    boost::json::object members;
+    for (const auto &[name, digest] : admission.members) members[name] = digest;
+    boost::json::object record{
+        {"format", FORMAT}, {"path", directory.generic_string()}, {"fingerprint", binding},
+        {"manifest", *manifest}, {"manifest_digest", admission.manifest_sha256},
+        {"artifact_digest", admission.artifact_sha256}, {"signing_key", admission.signing_key_identity},
+        {"transaction", admission.transaction_identity}, {"unsigned", admission.unsigned_exception},
+        {"super", admission.super_exception}, {"members", std::move(members)}};
+    auto mac = seal_mac(policy.validation_state->seal_key, record);
+    if (!mac) return std::unexpected(mac.error());
+    record["mac"] = *mac;
+    auto context = service::get_current_call_context();
+    context[OWNER] = policy.validation_state->owner;
+    context[KIND] = "verification";
+    context[EPOCH] = std::to_string(epoch);
+    service::ScopedCallContext guard(std::move(context));
+    auto written = Storage::fs_write_text((directory / TEMP).generic_string(), boost::json::serialize(record), TIMEOUT);
+    if (!written) return std::unexpected(written.error());
+    return Storage::fs_rename((directory / TEMP).generic_string(), (directory / SEAL).generic_string(), TIMEOUT);
+}
+}
+
+std::expected<void, std::string> initialize_runtime_package_validation(
+    RuntimePackagePolicy &policy, const std::vector<std::string> &roots)
+{
+    if (!policy.enforce || !policy.reuse_verified_installations) return {};
+    if (roots.empty()) return std::unexpected("package_protection_roots_missing");
+    auto state = std::make_shared<PackageValidationState>();
+    for (const auto &raw : roots) {
+        const fs::path path(raw);
+        if (!path.is_absolute() || path.lexically_normal() != path)
+            return std::unexpected("invalid_package_protection_root");
+        state->roots.push_back(path);
+    }
+    static std::atomic<uint64_t> next_owner{0};
+    state->owner = std::to_string(++next_owner);
+    state->key_path = policy.public_key_pem_path;
+    service::Storage::get_instance().set_file_system_mutation_guard(
+        [state](const fs::path &path, const service::CallContext &context) {
+            return before_mutation(state, path, context);
+        });
+    service::Storage::get_instance().set_key_value_access_guard(
+        [state](const std::string &nspace, const service::CallContext &context) -> std::expected<void, std::string> {
+            if (nspace != KEY_NAMESPACE) return {};
+            auto owner = context.find(OWNER);
+            if (owner == context.end() || owner->second != state->owner)
+                return std::unexpected("package_verification_key_private");
+            return {};
+        });
+    policy.validation_state = state;
+    return {};
+}
+
+detail::PackageMutationScope::PackageMutationScope(const RuntimePackagePolicy &policy)
+{
+    if (!policy.validation_state) return;
+    auto context = service::get_current_call_context();
+    context[OWNER] = policy.validation_state->owner;
+    context[KIND] = "mutation";
+    context_.emplace(std::move(context));
+}
+
+bool is_runtime_package_validation_current(std::string_view path, const RuntimePackagePolicy &policy)
+{
+    if (!policy.reuse_verified_installations || !policy.validation_state) return !policy.reuse_verified_installations;
+    std::lock_guard lock(policy.validation_state->mutex);
+    return policy.validation_state->configuration == configuration_key(policy) &&
+           policy.validation_state->admissions.contains(std::string(path));
+}
+
+std::expected<PackageAdmission, std::string> validate_installed_runtime_package(
+    std::string_view path, std::string_view system, const RuntimePackagePolicy &policy,
+    bool for_start, bool pending)
+{
+    if (!policy.reuse_verified_installations || pending || !policy.enforce)
+        return detail::validate_installed_runtime_package_full(path, system, policy, for_start, pending);
+    if (!policy.validation_state) return std::unexpected("package_protection_not_initialized");
+    auto binding = fingerprint(policy, system);
+    if (!binding) return std::unexpected(binding.error());
+    const auto state = policy.validation_state;
+    uint64_t epoch;
+    {
+        std::lock_guard lock(state->mutex);
+        epoch = state->epoch;
+        auto found = state->admissions.find(std::string(path));
+        if (found != state->admissions.end()) {
+            if (for_start && found->second.requires_developer() && !policy.developer())
+                return std::unexpected("developer_mode_required");
+            profile_validation(path, "memory");
+            return found->second;
+        }
+    }
+    const fs::path directory{std::string(path)};
+    bool protected_directory = false;
+    for (const auto &root : state->roots)
+        if (directory.parent_path() == root && !directory.filename().string().starts_with('.')) protected_directory = true;
+    if (!protected_directory) return detail::validate_installed_runtime_package_full(path, system, policy, for_start, pending);
+    auto admission = read_seal(directory, *binding, state->seal_key);
+    if (admission) profile_validation(path, "persistent");
+    if (!admission) {
+        if (admission.error() == "package_transaction_pending") return std::unexpected(admission.error());
+        profile_validation(path, "full");
+        admission = detail::validate_installed_runtime_package_full(path, system, policy, false, false);
+        if (!admission) return std::unexpected(admission.error());
+        if (admission->manifest_sha256.empty()) {
+            auto manifest = admission->members.find("manifest.json");
+            if (manifest == admission->members.end()) return std::unexpected("package_manifest_digest_missing");
+            admission->manifest_sha256 = manifest->second;
+            admission->transaction_identity = "builtin-" + *binding;
+        }
+        auto sealed = write_seal(directory, *admission, policy, *binding, epoch);
+        if (!sealed) return std::unexpected(sealed.error());
+    }
+    {
+        std::lock_guard lock(state->mutex);
+        if (epoch != state->epoch) return std::unexpected("package_verification_changed");
+        state->admissions[std::string(path)] = *admission;
+    }
+    if (for_start && admission->requires_developer() && !policy.developer())
+        return std::unexpected("developer_mode_required");
+    return admission;
+}
