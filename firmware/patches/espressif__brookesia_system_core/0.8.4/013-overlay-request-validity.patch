+bool System::has_app_keyboard_request(AppId app_id, KeyboardRequestId request_id)
+{
+    if (impl_->should_schedule_app_task() && !is_blocking_runtime_service_call_context()) {
+        return impl_->run_task_sync<bool>(SYSTEM_APP_TASK_GROUP,
+            [this, app_id, request_id]() { return has_app_keyboard_request(app_id, request_id); }, false);
+    }
+    const auto it = impl_->keyboard_requests_.find(request_id);
+    return it != impl_->keyboard_requests_.end() && it->second.app_id == app_id;
+}
+
+bool System::has_message_dialog_request(AppId app_id, MessageDialogRequestId request_id)
+{
+    if (impl_->should_schedule_app_task() && !is_blocking_runtime_service_call_context()) {
+        return impl_->run_task_sync<bool>(SYSTEM_APP_TASK_GROUP,
+            [this, app_id, request_id]() { return has_message_dialog_request(app_id, request_id); }, false);
+    }
+    const auto it = impl_->message_dialog_requests_.find(request_id);
+    return it != impl_->message_dialog_requests_.end() && it->second.app_id == app_id &&
+           impl_->active_message_dialog_request_id_ == request_id;
+}
