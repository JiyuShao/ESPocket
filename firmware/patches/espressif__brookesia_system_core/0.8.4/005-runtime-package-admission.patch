+std::expected<std::map<std::string, std::string>, std::string> directory_members(
+    const fs::path &root, const fs::path &relative = {})
+{
+    if (std::distance(relative.begin(), relative.end()) > 16) return std::unexpected("installed_path_depth_limit");
+    std::map<std::string, std::string> result;
+    auto entries = service::helper::Storage::fs_list((root / relative).generic_string(), STORAGE_FS_TIMEOUT_MS);
+    if (!entries) return std::unexpected(entries.error());
+    for (const auto &entry : *entries) {
+        if (!is_safe_relative_path(entry.name) || entry.name.find('/') != std::string::npos)
+            return std::unexpected("unsafe_installed_member");
+        const auto name = (relative / entry.name).generic_string();
+        if (relative.empty() && (package_private(name) || name == RECEIPT || name == PENDING || name == ARCHIVE)) continue;
+        if (entry.info.type == service::helper::Storage::FileType::Directory) {
+            auto nested = directory_members(root, relative / entry.name);
+            if (!nested) return std::unexpected(nested.error());
+            result.insert(nested->begin(), nested->end());
+        } else if (entry.info.type == service::helper::Storage::FileType::File) {
+            auto bytes = read_binary_file(root / name);
+            if (!bytes) return std::unexpected(bytes.error());
+            auto digest = package_sha256(*bytes);
+            if (!digest) return std::unexpected(digest.error());
+            result.emplace(name, std::move(*digest));
+        } else return std::unexpected("unsupported_installed_member");
+    }
+    return result;
+}
