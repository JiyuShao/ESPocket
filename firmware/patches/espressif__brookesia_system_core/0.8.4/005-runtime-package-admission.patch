+std::expected<PackageAdmission, std::string> inspect_runtime_package(
+    std::string_view path, std::string_view system, const RuntimePackagePolicy &policy,
+    std::string_view expected_sha256)
+{
+    auto bytes = read_binary_file(fs::path(std::string(path)));
+    if (!bytes) return std::unexpected(bytes.error());
+    auto entries = parse_central_directory(*bytes);
+    if (!entries) return std::unexpected(entries.error());
+    if (entries->size() > 1024) return std::unexpected("package_member_limit");
+    PackageAdmission result;
+    std::string manifest_text;
+    std::set<std::string> names;
+    std::map<std::string, std::string> directory_names;
+    std::set<std::string> file_names;
+    bool hash = false, signature = false;
+    uint64_t total = 0;
+    for (const auto &entry : *entries) {
+        auto name = entry.name;
+        if (entry.is_directory) name.pop_back();
+        const fs::path member_path(name);
+        if (name.size() > 192 || std::distance(member_path.begin(), member_path.end()) > 16 ||
+            !is_safe_relative_path(name) || fs::path(name).lexically_normal().generic_string() != name ||
+            package_private(name) || name.starts_with(".brookesia-"))
+            return std::unexpected("unsafe_package_member: " + name);
+        std::string folded = name;
+        std::transform(folded.begin(), folded.end(), folded.begin(), [](unsigned char c) { return std::tolower(c); });
+        if (package_private(folded) || folded.starts_with(".brookesia-")) return std::unexpected("reserved_package_member");
+        if (entry.is_directory) directory_names.try_emplace(folded, name);
+        else file_names.insert(folded);
+        for (auto parent = fs::path(name).parent_path(); !parent.empty(); parent = parent.parent_path()) {
+            const auto spelling = parent.generic_string();
+            auto key = spelling;
+            std::transform(key.begin(), key.end(), key.begin(), [](unsigned char c) { return std::tolower(c); });
+            auto [found, inserted] = directory_names.try_emplace(key, spelling);
+            if (!inserted && found->second != spelling) return std::unexpected("package_directory_case_collision");
+        }
+        if (!names.insert(folded).second) return std::unexpected("duplicate_package_member: " + name);
+        if (entry.flags & 1U) return std::unexpected("encrypted_zip_not_supported");
+        if (entry.uncompressed_size > 16U * 1024U * 1024U || (total += entry.uncompressed_size) > 64U * 1024U * 1024U)
+            return std::unexpected("package_expansion_limit");
+        if (entry.is_directory) continue;
+        if (name.starts_with("META-INF/")) {
+            if (name == "META-INF/hash.json") hash = true;
+            else if (name == "META-INF/signature.sig") signature = true;
+            else return std::unexpected("unknown_signature_member");
+        }
+        // Local header name/method/flags must agree with the central directory.
+        const size_t offset = entry.local_header_offset;
+        if (!check_range(offset, 30, bytes->size())) return std::unexpected("invalid_local_header");
+        const auto length = read_u16_le(*bytes, offset + 26);
+        if (!check_range(offset + 30, length, bytes->size()) ||
+            std::string(reinterpret_cast<const char *>(bytes->data() + offset + 30), length) != name ||
+            read_u16_le(*bytes, offset + 8) != entry.compression_method ||
+            read_u16_le(*bytes, offset + 6) != entry.flags)
+            return std::unexpected("zip_header_mismatch");
+        auto data = extract_zip_entry(*bytes, entry);
+        if (!data || data->size() != entry.uncompressed_size) return std::unexpected("unreadable_package_member: " + name);
+        if (crc32(0, data->data(), data->size()) != entry.crc)
+            return std::unexpected("package_member_crc_mismatch: " + name);
+        if (name == "manifest.json") manifest_text.assign(data->begin(), data->end());
+        if (!name.starts_with("META-INF/")) {
+            auto digest = package_sha256(*data);
+            if (!digest) return std::unexpected(digest.error());
+            result.members.emplace(name, std::move(*digest));
+        }
+    }
+    for (const auto &name : file_names) if (directory_names.contains(name)) return std::unexpected("package_file_directory_collision");
+    if (manifest_text.empty()) return std::unexpected("manifest_missing");
+    // A file cannot also be a parent directory (including case-insensitive collisions).
+    for (const auto &[name, digest] : result.members) {
+        for (auto parent = fs::path(name).parent_path(); !parent.empty(); parent = parent.parent_path()) {
+            auto found = result.members.find(parent.generic_string());
+            if (found != result.members.end()) return std::unexpected("package_file_directory_collision");
+        }
+    }
+    if (hash != signature) return std::unexpected("incomplete_release_signature");
+    auto artifact = package_sha256(*bytes);
+    if (!artifact) return std::unexpected(artifact.error());
+    result.artifact_sha256 = *artifact;
+    if (!expected_sha256.empty() && (!valid_digest(expected_sha256) || expected_sha256 != *artifact))
+        return std::unexpected("artifact_digest_mismatch");
+    auto manifest_digest = package_sha256(std::vector<uint8_t>(manifest_text.begin(), manifest_text.end()));
+    if (!manifest_digest) return std::unexpected(manifest_digest.error());
+    result.manifest_sha256 = *manifest_digest;
+    auto manifest = parse_manifest_to_app_manifest(manifest_text, {}, system);
+    if (!manifest) {
+        if (!policy.enforce || !policy.developer() || !manifest.error().starts_with(UNSUPPORTED_SYSTEM_ERROR_PREFIX))
+            return std::unexpected(manifest.error());
+        manifest = parse_manifest_to_app_manifest(manifest_text, {}, "super");
+        if (!manifest) return std::unexpected(manifest.error());
+        // A super exception must be an explicit declaration, never an empty wildcard.
+        if (std::find(manifest->supported_systems.begin(), manifest->supported_systems.end(), "super") == manifest->supported_systems.end())
+            return std::unexpected("super_not_declared");
+        result.super_exception = true;
+    }
+    result.manifest = std::move(*manifest);
+    if (!result.members.contains(result.manifest.entry)) return std::unexpected("runtime_entry_missing");
+    if (!policy.enforce) return result;
+    if (!hash) {
+        if (!policy.developer()) return std::unexpected("unsigned_package_requires_developer_mode");
+        result.unsigned_exception = true;
+        result.signing_key_identity = "unverified";
+    } else {
+        if (policy.public_key_pem_path.empty()) return std::unexpected("release_trust_key_unavailable");
+        auto key_bytes = read_binary_file(policy.public_key_pem_path);
+        if (!key_bytes) return std::unexpected("release_trust_key_unavailable: " + key_bytes.error());
+        auto key_digest = package_sha256(*key_bytes);
+        if (!key_digest) return std::unexpected(key_digest.error());
+        auto verified = verify_app_package_release_bytes(*bytes, {policy.public_key_pem_path});
+        if (!verified) return std::unexpected("release_signature_invalid: " + verified.error());
+        result.signing_key_identity = "sha256:" + *key_digest;
+    }
+    return result;
+}
+
+std::expected<void, std::string> write_runtime_package_receipt(
+    std::string_view directory, const PackageAdmission &admission, const RuntimePackagePolicy &policy)
+{
+    const auto transaction = admission.transaction_identity.empty()
+        ? "transaction-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count())
+        : admission.transaction_identity;
+    boost::json::object members;
+    for (const auto &[name, digest] : admission.members) members[name] = digest;
+    boost::json::object receipt{
+        {"policy", POLICY_VERSION}, {"platform", policy.platform_baseline},
+        {"id", admission.manifest.id}, {"version", admission.manifest.version},
+        {"artifact", admission.artifact_sha256}, {"manifest", admission.manifest_sha256},
+        {"transaction", transaction}, {"signing_key", admission.signing_key_identity},
+        {"members", std::move(members)}, {"unsigned", admission.unsigned_exception},
+        {"super", admission.super_exception}
+    };
+    const auto serialized = boost::json::serialize(receipt);
+    auto written = service::helper::Storage::fs_write_text((fs::path(std::string(directory)) / PENDING).generic_string(), serialized, STORAGE_FS_TIMEOUT_MS);
+    if (!written) return std::unexpected(written.error());
+    return {};
+}
+
+std::expected<void, std::string> commit_runtime_package_receipt(std::string_view directory)
+{
+    const fs::path root{std::string(directory)};
+    return package_rename(root / PENDING, root / RECEIPT);
+}
