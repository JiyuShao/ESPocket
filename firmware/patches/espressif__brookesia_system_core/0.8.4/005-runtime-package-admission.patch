+std::expected<std::string, std::string> package_sha256(const std::vector<uint8_t> &bytes)
+{
+#ifdef ESP_PLATFORM
+    unsigned char result[32];
+    const auto *algorithm = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (!algorithm || mbedtls_md(algorithm, bytes.data(), bytes.size(), result) != 0)
+        return std::unexpected("package_digest_unavailable");
+    std::string hex; hex.reserve(64);
+    constexpr char digits[] = "0123456789abcdef";
+    for (const auto value : result) { hex += digits[value >> 4]; hex += digits[value & 15]; }
+    return hex;
+#else
+    return std::unexpected("package_digest_unavailable");
+#endif
+}
+
+bool valid_digest(std::string_view value)
+{
+    return value.size() == 64 && std::all_of(value.begin(), value.end(), [](char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+    });
+}
+
+bool package_private(std::string_view name)
+{
+    const auto first = name.substr(0, name.find('/'));
+    return first == "data" || first == "cache" || first == "files";
+}
