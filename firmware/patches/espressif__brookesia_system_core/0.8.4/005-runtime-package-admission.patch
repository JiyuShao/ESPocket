+        if (allowed == policy.built_in_members.end()) return std::unexpected("package_receipt_missing");
+        if (!supports_system(manifest->supported_systems, system)) return std::unexpected("builtin_system_mismatch");
+        auto actual = directory_members(directory);
+        if (!actual || *actual != allowed->second) return std::unexpected("builtin_members_mismatch");
+        built_in.members = *actual;
+        return built_in;
+    }
+    if (stat->size > 512U * 1024U) return std::unexpected("package_receipt_size_limit");
+    auto text = read_text_file(directory / (pending ? PENDING : RECEIPT));
+    if (!text) return std::unexpected(text.error());
+    boost::system::error_code ec;
+    auto parsed = boost::json::parse(*text, ec);
+    if (ec || !parsed.is_object()) return std::unexpected("invalid_package_receipt");
+    const auto &receipt = parsed.as_object();
+    auto field = [&](const char *name) -> std::string {
+        const auto value = receipt.if_contains(name);
+        return value && value->is_string() ? std::string(value->as_string()) : "";
+    };
+    if (field("policy") != POLICY_VERSION || field("platform") != policy.platform_baseline ||
+        field("id") != manifest->id || field("version") != manifest->version ||
+        !valid_digest(field("artifact")) || !valid_digest(field("manifest")) ||
+        field("transaction").empty())
+        return std::unexpected("package_receipt_identity_mismatch");
+    // Recompute admission from the retained original package; receipt flags never grant trust.
+    auto inspect_policy = policy;
+    inspect_policy.developer_enabled = [] { return true; };
+    auto admission = inspect_runtime_package((directory / ARCHIVE).generic_string(), system, inspect_policy, field("artifact"));
+    if (!admission) return std::unexpected(admission.error());
+    if (admission->manifest.id != manifest->id || admission->manifest.version != manifest->version ||
+        admission->manifest_sha256 != field("manifest") ||
+        admission->signing_key_identity != field("signing_key"))
+        return std::unexpected("package_archive_identity_mismatch");
+    auto actual = directory_members(directory);
+    if (!actual || *actual != admission->members) return std::unexpected("installed_members_mismatch");
+    const auto recorded_members = receipt.if_contains("members");
+    const auto unsigned_flag = receipt.if_contains("unsigned"), super_flag = receipt.if_contains("super");
+    if (!recorded_members || !recorded_members->is_object() || recorded_members->as_object().size() != admission->members.size() ||
+        !unsigned_flag || !unsigned_flag->is_bool() || unsigned_flag->as_bool() != admission->unsigned_exception ||
+        !super_flag || !super_flag->is_bool() || super_flag->as_bool() != admission->super_exception)
+        return std::unexpected("package_receipt_content_mismatch");
+    for (const auto &[name, digest] : admission->members) {
+        const auto value = recorded_members->as_object().if_contains(name);
+        if (!value || !value->is_string() || value->as_string() != digest) return std::unexpected("package_receipt_content_mismatch");
+    }
+    if (for_start && admission->requires_developer() && !policy.developer())
+        return std::unexpected("developer_mode_required");
+    admission->manifest.app_path = std::string(path);
+    return admission;
+}
+
+std::expected<void, std::string> recover_runtime_package_updates(
+    std::string_view root_path, std::string_view system, const RuntimePackagePolicy &policy)
+{
+    const fs::path root{std::string(root_path)};
+    const auto rollback_root = root / ".rollback";
+    auto stat = service::helper::Storage::fs_stat(rollback_root.generic_string(), STORAGE_FS_TIMEOUT_MS);
+    if (!stat) return std::unexpected(stat.error());
+    auto roots = service::helper::Storage::fs_list(root.generic_string(), STORAGE_FS_TIMEOUT_MS);
+    if (!roots) return std::unexpected(roots.error());
+    for (const auto &entry : *roots) {
+        if (entry.name.starts_with('.') || entry.info.type != service::helper::Storage::FileType::Directory) continue;
+        const auto final = root / entry.name, backup = rollback_root / entry.name;
+        auto receipt = service::helper::Storage::fs_stat((final / RECEIPT).generic_string(), STORAGE_FS_TIMEOUT_MS);
+        auto pending = service::helper::Storage::fs_stat((final / PENDING).generic_string(), STORAGE_FS_TIMEOUT_MS);
+        auto backup_stat = service::helper::Storage::fs_stat(backup.generic_string(), STORAGE_FS_TIMEOUT_MS);
+        if (!receipt || !pending || !backup_stat) return std::unexpected("package recovery stat failed");
+        if (!receipt->exists && pending->exists && !backup_stat->exists) {
+            auto removed = package_remove(final);
+            if (!removed) return removed;
+        }
+    }
+    if (!stat->exists) {
+        const auto installing = root / ".installing";
+        auto installing_stat = service::helper::Storage::fs_stat(installing.generic_string(), STORAGE_FS_TIMEOUT_MS);
+        if (!installing_stat) return std::unexpected(installing_stat.error());
+        return installing_stat->exists ? package_remove(installing) : std::expected<void, std::string>{};
+    }
+    auto entries = service::helper::Storage::fs_list(rollback_root.generic_string(), STORAGE_FS_TIMEOUT_MS);
+    if (!entries) return std::unexpected(entries.error());
+    for (const auto &entry : *entries) {
+        if (!is_safe_relative_path(entry.name) || entry.name.find('/') != std::string::npos || entry.name.starts_with('.'))
+            return std::unexpected("invalid_rollback_identity");
+        const auto backup = rollback_root / entry.name, installed = root / entry.name;
+        const auto current = validate_installed_runtime_package(installed.generic_string(), system, policy, false);
+        if (current) {
+            auto removed = package_remove(backup);
+            if (!removed) return removed;
+        } else {
+            auto previous = validate_installed_runtime_package(backup.generic_string(), system, policy, false);
+            if (!previous) return std::unexpected("rollback_backup_invalid: " + previous.error());
+            auto removed = package_remove(installed);
+            if (!removed) return removed;
+            auto restored = package_rename(backup, installed);
+            if (!restored) return restored;
+        }
+    }
+    const auto installing = root / ".installing";
+    auto installing_stat = service::helper::Storage::fs_stat(installing.generic_string(), STORAGE_FS_TIMEOUT_MS);
+    if (!installing_stat) return std::unexpected(installing_stat.error());
+    if (installing_stat->exists) return package_remove(installing);
+    return {};
+}
