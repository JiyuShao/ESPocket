+std::expected<void, std::string> System::gui_invoke_native_content(AppId app_id, const gui::NativeContentToken &token, const gui::NativeContentCallback &callback)
+{
+    return impl_->run_task_sync<std::expected<void, std::string>>(SYSTEM_GUI_TASK_GROUP,
+        [this, app_id, token, callback]() mutable -> std::expected<void, std::string> {
+            auto record_result = impl_->get_record(app_id);
+            if (!record_result || !impl_->gui_runtime_ || !record_result.value()->document_id.has_value() ||
+                record_result.value()->info.manifest.kind != AppKind::Native ||
+                record_result.value()->info.state == AppState::Installed ||
+                record_result.value()->info.state == AppState::Stopped ||
+                record_result.value()->info.state == AppState::Error) {
+                return std::unexpected("Native App GUI document is not loaded");
+            }
+            impl_->flush_pending_gui_bindings(app_id);
+            return impl_->gui_runtime_->invoke_native_content(*record_result.value()->document_id, token, callback);
+        }, std::unexpected("Native App GUI document is not loaded"));
+}
+bool System::gui_unmount_native_content(AppId app_id, const gui::NativeContentToken &token)
+{
+    return impl_->run_task_sync<bool>(SYSTEM_GUI_TASK_GROUP,
+        [this, app_id, token]() mutable -> bool {
+            auto record_result = impl_->get_record(app_id);
+            if (!record_result || !impl_->gui_runtime_ || !record_result.value()->document_id.has_value() ||
+                record_result.value()->info.manifest.kind != AppKind::Native) {
+                return false;
+            }
+            impl_->flush_pending_gui_bindings(app_id);
+            return impl_->gui_runtime_->unmount_native_content(*record_result.value()->document_id, token);
+        }, false);
+}
