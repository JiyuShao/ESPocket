+std::expected<void, std::string> System::Impl::call_runtime_pause_reasons_changed(
+    AppRecord &record, const AppPauseReasons &reasons)
+{
+    if (!runtime_ || !record.runtime_app_id.has_value()) return {};
+    // The locked NativeValue bridge supports scalars; serialize the same named snapshot.
+    const std::string snapshot = boost::json::serialize(boost::json::object{
+        {"covered", reasons.covered}, {"screen_off", reasons.screen_off},
+        {"manual_pause", reasons.manual_pause}});
+    auto result = runtime_->call_function(*record.runtime_app_id, APP_MODULE_NAME,
+                                         "on_pause_reasons_changed", {snapshot});
+    auto missing = [](std::string_view error) {
+        // Exact locked JavaScript backend errors; never swallow a callback exception
+        // merely because its message contains "not found".
+        return error == "JavaScript function not found" || error == "JavaScript host function not found";
+    };
+    if (!result && missing(result.error())) {
+        result = runtime_->call_function(*record.runtime_app_id, APP_MODULE_NAME,
+            "on_suspension_changed", {reasons.covered, reasons.screen_off, reasons.manual_pause});
+    }
+    if (!result) {
+        if (missing(result.error())) return {}; // Neither optional hook is exported.
+        return std::unexpected(result.error());
+    }
+    if (const auto *value = std::get_if<bool>(&*result); value && !*value)
+        return std::unexpected("Runtime pause reasons callback returned false");
+    return {};
+}
