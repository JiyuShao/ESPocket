+std::optional<AppExecutionState> System::app_execution_state(AppId app_id)
+{
+    if (impl_->should_schedule_app_task()) {
+        return impl_->run_task_sync<std::optional<AppExecutionState>>(SYSTEM_APP_TASK_GROUP,
+            [this, app_id] { return app_execution_state(app_id); }, std::nullopt);
+    }
+    auto found = impl_->get_record(app_id);
+    if (!found) return std::nullopt;
+    const auto &record = **found;
+    if (record.info.state != AppState::Starting && record.info.state != AppState::Running &&
+        record.info.state != AppState::Paused) return std::nullopt;
+    auto state = record.execution;
+    if (record.info.state == AppState::Running && !state.suspended() &&
+        impl_->active_app_id_ == app_id && impl_->config_.native_pointer_access)
+        state.activity_epoch = impl_->config_.native_pointer_access(app_id);
+    return state;
+}
+
+bool System::report_app_user_activity(AppId app_id, uint64_t instance, uint64_t epoch)
+{
+    if (impl_->should_schedule_app_task()) {
+        return impl_->run_task_sync<bool>(SYSTEM_APP_TASK_GROUP,
+            [this, app_id, instance, epoch] { return report_app_user_activity(app_id, instance, epoch); }, false);
+    }
+    const auto state = app_execution_state(app_id);
+    if (!state || instance == 0 || state->instance != instance || !state->activity_epoch ||
+        *state->activity_epoch != epoch || !impl_->config_.user_activity) return false;
+    impl_->config_.user_activity(app_id);
+    return true;
+}
