+void System::Impl::drain_deferred_timers()
+{
+    std::vector<PendingTimer> due;
+    {
+        std::lock_guard<std::recursive_mutex> lock(timer_map_mutex_);
+        for (auto &[id, record] : apps_) {
+            if (record.info.state != AppState::Running) continue;
+            for (auto &[timer_id, timer] : record.timers) {
+                if (!timer.deferred) continue;
+                timer.deferred = false;
+                due.push_back({id, timer_id, timer.name});
+            }
+        }
+    }
+    for (auto &timer : due) {
+        auto result = dispatch_timer(timer.app_id, timer.timer_id, std::move(timer.name));
+        if (!result) BROOKESIA_LOGW("Deferred timer failed: %1%", result.error());
+    }
+}
