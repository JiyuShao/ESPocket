+/* Codec consumers may stop a channel without updating Board Manager's init flags.
+ * Query the driver on IDF 6 before release; retain handles when release fails. */
+static int periph_i2s_release_channel(i2s_chan_handle_t handle, bool enabled_at_init)
+{
+#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(6, 0, 0)
+    i2s_chan_info_t info;
+    if (i2s_channel_get_info(handle, &info) != ESP_OK) {
+        return -1;
+    }
+    enabled_at_init = info.is_enabled;
+#endif
+    if (enabled_at_init && i2s_channel_disable(handle) != ESP_OK) {
+        return -1;
+    }
+    return i2s_del_channel(handle) == ESP_OK ? 0 : -1;
+}
