+/* Only fully opaque PNGs on RGB565 displays can use the copy path. Alpha
+ * is checked once at decode time; transparent and other-display buffers retain
+ * their original precision and format. Allocation failure keeps the valid PNG.
+ */
+static lv_draw_buf_t * optimize_opaque_png(lv_draw_buf_t * buf)
+{
+    if (get_target_rgb_format() != LV_COLOR_FORMAT_RGB565 ||
+            buf->header.cf != LV_COLOR_FORMAT_ARGB8888) {
+        return buf;
+    }
+    for (uint32_t y = 0; y < buf->header.h; ++y) {
+        const uint8_t * row = buf->data + y * buf->header.stride;
+        for (uint32_t x = 0; x < buf->header.w; ++x) {
+            if (row[x * 4 + 3] != 255) {
+                return buf;
+            }
+        }
+    }
+    lv_draw_buf_t * rgb = lv_draw_buf_create_ex(image_cache_draw_buf_handlers,
+                         buf->header.w, buf->header.h, LV_COLOR_FORMAT_RGB565, LV_STRIDE_AUTO);
+    if (rgb == NULL) {
+        return buf;
+    }
+    for (uint32_t y = 0; y < buf->header.h; ++y) {
+        const uint8_t * row = buf->data + y * buf->header.stride;
+        uint8_t * out = rgb->data + y * rgb->header.stride;
+        for (uint32_t x = 0; x < buf->header.w; ++x) {
+            const uint8_t * pixel = row + x * 4;
+            const uint16_t value = ((uint16_t)(pixel[2] >> 3) << 11) |
+                                   ((uint16_t)(pixel[1] >> 2) << 5) | (pixel[0] >> 3);
+            memcpy(out + x * 2, &value, sizeof(value));
+        }
+    }
+    lv_draw_buf_destroy_user(image_cache_draw_buf_handlers, buf);
+    return rgb;
+}
