+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <vector>
+namespace esp_brookesia::gui {
+struct NativePointerPoint { int32_t x = 0, y = 0; uint8_t track_id = 0; };
+struct NativePointerFrame {
+    std::vector<NativePointerPoint> points;
+    uint32_t sequence = 0;
+    uint64_t updated_at_ms = 0;
+    bool valid = false;
+    bool cancelled = true;
+};
+/** Per-mount delivery state, not a hardware sampler or input manager.
+ * After any revocation, require a NEW all-released sample before delivering
+ * points again. This also covers pauses during which the App did not poll.
+ */
+class NativePointerDelivery {
+public:
+    NativePointerFrame filter(NativePointerFrame frame, std::optional<uint64_t> epoch) {
+        if (!epoch || !frame.valid || epoch_ != epoch) {
+            blocked_ = true;
+            barrier_ = frame.sequence;
+        }
+        epoch_ = epoch;
+        if (epoch && frame.valid && blocked_ && frame.sequence != barrier_ && frame.points.empty()) {
+            blocked_ = false;
+        }
+        frame.cancelled = !epoch || !frame.valid || blocked_;
+        if (frame.cancelled) { frame.points.clear(); }
+        return frame;
+    }
+private:
+    std::optional<uint64_t> epoch_;
+    uint32_t barrier_ = 0;
+    bool blocked_ = true;
+};
+} // namespace esp_brookesia::gui
