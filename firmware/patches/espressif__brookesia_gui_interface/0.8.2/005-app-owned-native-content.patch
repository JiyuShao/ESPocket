+namespace esp_brookesia::gui {
+/** Trusted native extension. All callbacks run under the backend thread guard.
+ * Callbacks must not reenter document/node/mount lifecycle operations. Resources
+ * outside the owned subtree (timers, event connections, workers) must be stopped
+ * synchronously by detach, including after a partially failed attach.
+ */
+class NativeContent {
+public:
+    virtual ~NativeContent() = default;
+    virtual std::string_view backend_key() const noexcept = 0;
+};
+using NativeContentCallback = std::function<void(NativeContent &)>;
+/** Opaque identity for one mount; copying it does not extend the mount lifetime. */
+class NativeContentToken {
+public:
+    NativeContentToken() = default;
+private:
+    friend class Runtime;
+    std::weak_ptr<const uint8_t> runtime_identity_;
+    DocumentId document_id_;
+    BackendHandle handle_;
+    uint64_t mount_id_ = 0;
+};
+} // namespace esp_brookesia::gui
