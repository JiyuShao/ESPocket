+std::expected<NativeContentToken, std::string> Runtime::mount_native_content(
+    DocumentId id, std::string_view absolute_path, std::shared_ptr<NativeContent> content)
+try {
+    // Refresh first: a live-preview replacement must revoke the previous backend mount.
+    auto refreshed = impl_->refresh_document_if_dirty(this, id);
+    if (!refreshed) { return std::unexpected(refreshed.error()); }
+    auto *tree = impl_->resolve_tree(id);
+    if (!tree || !content) { return std::unexpected("Native content or document is missing"); }
+    auto uid = impl_->resolve_any_uid(*tree, normalize_absolute_path(absolute_path));
+    auto *node = uid ? impl_->find_node_record(*tree, *uid) : nullptr;
+    if (!node || node->node().type != NodeType::Container) {
+        return std::unexpected("Native content requires an existing container");
+    }
+    auto mounted = impl_->backend->mount_native_content(node->handle, std::move(content));
+    if (!mounted) { return std::unexpected(mounted.error()); }
+    NativeContentToken token;
+    token.runtime_identity_ = impl_->native_identity_;
+    token.document_id_ = id;
+    token.handle_ = node->handle;
+    token.mount_id_ = *mounted;
+    return token;
+}
+catch (const std::bad_alloc &) { return std::unexpected("GUI out of memory"); }
+
+std::expected<void, std::string> Runtime::invoke_native_content(
+    DocumentId id, const NativeContentToken &token, const NativeContentCallback &callback)
+{
+    auto refreshed = impl_->refresh_document_if_dirty(this, id);
+    if (!refreshed) { return std::unexpected(refreshed.error()); }
+    auto *tree = impl_->resolve_tree(id);
+    if (token.runtime_identity_.lock() != impl_->native_identity_ || token.document_id_ != id ||
+        !tree || !tree->handle_to_uid.contains(token.handle_.value())) {
+        return std::unexpected("Native content token is stale or belongs to another document");
+    }
+    return impl_->backend->invoke_native_content(token.handle_, token.mount_id_, callback);
+}
+bool Runtime::unmount_native_content(DocumentId id, const NativeContentToken &token)
+{
+    auto *tree = impl_->resolve_tree(id);
+    if (token.runtime_identity_.lock() != impl_->native_identity_ || token.document_id_ != id ||
+        !tree || !tree->handle_to_uid.contains(token.handle_.value())) { return false; }
+    return impl_->backend->unmount_native_content(token.handle_, token.mount_id_);
+}
+
+void Runtime::clear_native_content(DocumentId id)
+{
+    auto *tree = impl_->resolve_tree(id);
+    if (!tree) { return; }
+    for (const auto &[unused_uid, node] : tree->nodes) {
+        (void)unused_uid;
+        impl_->backend->clear_native_content(node.handle);
+    }
+}
