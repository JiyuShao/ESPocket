+#pragma once
+#include <cstdint>
+#include <expected>
+#include <string>
+
+namespace esp_brookesia::gui::lvgl {
+// LVGL decoders and cache are global. Configure once after decoder registration,
+// release before decoder destruction. All calls require the GUI thread guard.
+// Failure leaves every decoder callback unchanged. This policy covers Native and Runtime images.
+struct ImageDecodePolicy {
+    uint32_t cache_bytes = 0;
+    uint32_t workspace_bytes = 0;
+};
+struct ImageDecodeStatistics {
+    uint64_t attempts = 0, successes = 0, total_us = 0, max_us = 0, pressure_evictions = 0;
+};
+std::expected<void, std::string> configure_image_decoding(ImageDecodePolicy policy);
+void release_image_decoding();
+void set_image_decode_statistics_enabled(bool enabled);
+ImageDecodeStatistics take_image_decode_statistics();
+} // namespace esp_brookesia::gui::lvgl
