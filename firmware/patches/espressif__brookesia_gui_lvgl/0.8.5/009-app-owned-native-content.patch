+void BackendImpl::revoke_native_content(Record &record)
+{
+    // Remove identity BEFORE user cleanup, while the parent still exists.
+    auto mount = std::move(record.native_mount);
+    if (!mount) { return; }
+    mount->content->detach();
+    mount->content->mounted_ = false;
+    if (mount->root && lv_obj_is_valid(mount->root)) { lv_obj_delete(mount->root); }
+}
+std::expected<uint64_t, std::string> BackendImpl::mount_native_content(
+    BackendHandle handle, std::shared_ptr<gui::NativeContent> content)
+{
+    ThreadLockGuard lock;
+    auto *record = find_record(handle);
+    if (!record || record->type != NodeType::Container || !record->object ||
+        !lv_obj_is_valid(record->object) || !content || content->backend_key() != NativeContent::KEY) {
+        return std::unexpected("Invalid LVGL native content container or backend");
+    }
+    if (record->native_mount) { return std::unexpected("Container already has native content"); }
+    if (next_native_mount_id_ == 0) { return std::unexpected("Native mount identity exhausted"); }
+    auto mount = std::make_unique<Record::NativeMount>();
+    mount->id = next_native_mount_id_++;
+    // Backend key is the trusted Native extension ABI; LVGL implementations derive
+    // from lvgl::NativeContent. This does not require RTTI on embedded targets.
+    mount->content = std::static_pointer_cast<lvgl::NativeContent>(std::move(content));
+    if (mount->content->mounted_) { return std::unexpected("Native content is already mounted"); }
+    mount->root = lv_obj_create(record->object);
+    if (!mount->root) { return std::unexpected("Native content root allocation failed"); }
+    lv_obj_remove_style_all(mount->root);
+    lv_obj_set_size(mount->root, LV_PCT(100), LV_PCT(100));
+    lv_obj_remove_flag(mount->root, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(mount->root, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
+    mount->content->mounted_ = true;
+    record->native_mount = std::move(mount);
+    try {
+        auto attached = record->native_mount->content->attach(record->native_mount->root);
+        if (!attached) {
+            auto error = std::move(attached.error());
+            revoke_native_content(*record);
+            return std::unexpected(std::move(error));
+        }
+    } catch (...) {
+        // Revoke before allocating an error string, including on bad_alloc.
+        revoke_native_content(*record);
+        return std::unexpected("Native attach failed");
+    }
+    return record->native_mount->id;
+}
+std::expected<void, std::string> BackendImpl::invoke_native_content(
+    BackendHandle handle, uint64_t mount_id, const NativeContentCallback &callback)
+{
+    ThreadLockGuard lock;
+    auto *record = find_record(handle);
+    if (!record || !record->native_mount || record->native_mount->id != mount_id || !callback) {
+        return std::unexpected("Native content token is stale or callback is empty");
+    }
+    try { callback(*record->native_mount->content); }
+    catch (const std::exception &error) { return std::unexpected(error.what()); }
+    catch (...) { return std::unexpected("Native content callback threw"); }
+    return {};
+}
+bool BackendImpl::unmount_native_content(BackendHandle handle, uint64_t mount_id)
+{
+    ThreadLockGuard lock;
+    auto *record = find_record(handle);
+    if (!record || !record->native_mount || record->native_mount->id != mount_id) { return false; }
+    revoke_native_content(*record);
+    return true;
+}
+
+std::expected<NativePointerFrame, std::string> BackendImpl::read_native_pointer_frame(
+    BackendHandle handle, uint64_t mount_id, std::optional<uint64_t> access_epoch)
+{
+    ThreadLockGuard lock;
+    auto *record = find_record(handle);
+    if (!record || !record->native_mount || record->native_mount->id != mount_id) {
+        return std::unexpected("Native content token is stale");
+    }
+    auto frame = DisplaySource::get_instance().cached_pointer_frame();
+    // A hidden/reparented native root cannot acquire input merely by holding a token.
+    if (!lv_obj_is_visible(record->native_mount->root) ||
+        lv_obj_get_display(record->native_mount->root) != DisplaySource::get_instance().display()) {
+        access_epoch.reset();
+    }
+    frame = record->native_mount->pointer_delivery.filter(std::move(frame), access_epoch);
+    lv_area_t area;
+    lv_obj_get_coords(record->native_mount->root, &area);
+    std::erase_if(frame.points, [&](const auto &point) {
+        return point.x < area.x1 || point.x > area.x2 || point.y < area.y1 || point.y > area.y2;
+    });
+    for (auto &point : frame.points) { point.x -= area.x1; point.y -= area.y1; }
+    return frame;
+}
