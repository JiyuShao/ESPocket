+typedef struct _lv_obj_t lv_obj_t;
+namespace esp_brookesia::gui::lvgl {
+/** LVGL-specific native extension. The backend owns and clips the supplied root.
+ * Do not delete/reparent the root or retain it beyond detach. Create children
+ * only below it; never take over a display or a global layer.
+ * detach must be noexcept, idempotent, and safe after a failed attach.
+ */
+class NativeContent : public gui::NativeContent {
+public:
+    static constexpr std::string_view KEY = "brookesia.lvgl.native-content.v1";
+    std::string_view backend_key() const noexcept final { return KEY; }
+    virtual std::expected<void, std::string> attach(lv_obj_t *root) = 0;
+    virtual void detach() noexcept = 0;
+private:
+    friend class BackendImpl;
+    bool mounted_ = false;
+
+};
+} // namespace esp_brookesia::gui::lvgl
