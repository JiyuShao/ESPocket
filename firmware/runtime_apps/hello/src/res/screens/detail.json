{
  "type": "viewScreen",
  "id": "detail",
  "commonProps": {
    "scrollable": false
  },
  "style": {
    "padding": 0
  },
  "layout": {
    "type": "flex",
    "flexFlow": "column",
    "mainAlign": "center",
    "crossAlign": "center",
    "gap": "10dp"
  },
  "children": [
    {
      "type": "label",
      "id": "title",
      "labelProps": {
        "text": "Runtime Detail"
      },
      "style": {
        "fontSize": "26sp"
      },
      "placement": {
        "width": "280dp",
        "height": "44dp"
      },
      "styleRefs": [
        "app.cardTitle"
      ]
    },
    {
      "type": "label",
      "id": "hint",
      "labelProps": {
        "text": "Edge Back returns to Root"
      },
      "style": {
        "fontSize": "17sp",
        "textAlign": "center"
      },
      "placement": {
        "width": "300dp",
        "height": "30dp"
      },
      "styleRefs": [
        "app.caption"
      ]
    },
    {
      "type": "button",
      "id": "confirm",
      "events": [
        {
          "type": "clicked",
          "action": "toggle_confirm"
        }
      ],
      "style": {
        "radius": "22dp"
      },
      "placement": {
        "width": "230dp",
        "height": "44dp"
      },
      "children": [
        {
          "type": "label",
          "id": "label",
          "labelProps": {
            "text": "Confirm Back: Off"
          },
          "style": {
            "fontSize": "17sp"
          },
          "placement": {
            "mode": "relative",
            "align": "center"
          },
          "styleRefs": [
            "app.actionText"
          ]
        }
      ],
      "styleRefs": [
        "app.action"
      ]
    },
    {
      "type": "button",
      "id": "allow",
      "events": [
        {
          "type": "clicked",
          "action": "allow_back"
        }
      ],
      "style": {
        "radius": "22dp"
      },
      "placement": {
        "width": "230dp",
        "height": "44dp"
      },
      "children": [
        {
          "type": "label",
          "id": "label",
          "labelProps": {
            "text": "Allow Back"
          },
          "style": {
            "fontSize": "17sp"
          },
          "placement": {
            "mode": "relative",
            "align": "center"
          },
          "styleRefs": [
            "app.actionText"
          ]
        }
      ],
      "styleRefs": [
        "app.action"
      ]
    },
    {
      "type": "button",
      "id": "cancel",
      "events": [
        {
          "type": "clicked",
          "action": "cancel_back"
        }
      ],
      "style": {
        "radius": "22dp"
      },
      "placement": {
        "width": "230dp",
        "height": "44dp"
      },
      "children": [
        {
          "type": "label",
          "id": "label",
          "labelProps": {
            "text": "Cancel Back"
          },
          "style": {
            "fontSize": "17sp"
          },
          "placement": {
            "mode": "relative",
            "align": "center"
          },
          "styleRefs": [
            "app.actionText"
          ]
        }
      ],
      "styleRefs": [
        "app.action"
      ]
    }
  ],
  "styleRefs": [
    "app.page"
  ]
}
