{
  "version": 1,
  "appId": "espocket.app.hello_runtime",
  "cards": [
    {
      "cardId": "summary",
      "screen": "/card",
      "gui": {
        "version": "0.1.0",
        "assets": [
          {
            "type": "viewScreen",
            "id": "card",
            "commonProps": {
              "scrollable": false
            },
            "style": {
              "padding": 0
            },
            "layout": {
              "type": "flex",
              "flexFlow": "column",
              "mainAlign": "center",
              "crossAlign": "center",
              "gap": "20dp"
            },
            "children": [
              {
                "type": "label",
                "id": "title",
                "labelProps": {
                  "text": "Hello Runtime Card"
                },
                "style": {
                  "fontSize": "32sp",
                  "textAlign": "center"
                },
                "placement": {
                  "width": "300dp",
                  "height": "44dp"
                },
                "styleRefs": [
                  "app.cardTitle"
                ]
              },
              {
                "type": "label",
                "id": "version",
                "labelProps": {
                  "text": "Version: 0.1.0"
                },
                "style": {
                  "fontSize": "20sp",
                  "textAlign": "center"
                },
                "placement": {
                  "width": "220dp",
                  "height": "30dp"
                },
                "styleRefs": [
                  "app.caption"
                ]
              },
              {
                "type": "button",
                "id": "open",
                "events": [
                  {
                    "type": "clicked",
                    "action": "espocket.card.open"
                  }
                ],
                "style": {
                  "radius": "24dp"
                },
                "placement": {
                  "width": "190dp",
                  "height": "54dp"
                },
                "children": [
                  {
                    "type": "label",
                    "id": "label",
                    "labelProps": {
                      "text": "Open App"
                    },
                    "style": {
                      "fontSize": "18sp"
                    },
                    "placement": {
                      "mode": "relative",
                      "align": "center"
                    },
                    "styleRefs": [
                      "app.actionText"
                    ]
                  }
                ],
                "styleRefs": [
                  "app.action"
                ]
              }
            ],
            "styleRefs": [
              "app.page"
            ]
          }
        ]
      },
      "bindings": [
        {
          "path": "/card/title",
          "source": "app.name"
        },
        {
          "path": "/card/version",
          "source": "app.version"
        }
      ]
    },
    {
      "cardId": "detail",
