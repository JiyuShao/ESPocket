{
  "type": "theme",
  "id": "dark",
  "assets": [
    {
      "type": "constant",
      "data": {
        "colors": {
          "border": {
            "default": "#46576b",
            "muted": "#293544",
            "strong": "#94a3b8"
          },
          "text": {
            "default": "#f1f5f9",
            "muted": "#b0bccb",
            "subtle": "#94a3b8",
            "inverse": "#10151c"
          },
          "primary": {
            "fill": "#59a9ff",
            "on": "#10151c",
            "soft": "#203a58",
            "hover": "#86c1ff"
          },
          "bg": {
            "base": "#10151c",
            "overlay": "#202934",
            "app": "#10151c",
            "scrim": "#07090d",
            "quick": "#151e2b"
          },
          "info": {
            "fill": "#59a9ff",
            "soft": "#203a58",
            "on": "#10151c"
          },
          "warning": {
            "fill": "#fdc800",
            "soft": "#574221",
            "on": "#10151c"
          },
          "surface": {
            "base": "#10151c",
            "raised": "#202934",
            "muted": "#293544",
            "pressed": "#203a58",
            "inverse": "#f1f5f9"
          },
          "success": {
            "fill": "#5fd28a",
            "soft": "#193b2b",
            "on": "#10151c"
          },
          "danger": {
            "fill": "#ff8e96",
            "soft": "#4a252a",
            "on": "#10151c"
          },
          "control": {
            "knob": "#ffffff"
          }
        }
      }
    }
  ],
  "styles": {
    "button": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.primaryChip": {
      "bgColor": "${color.primary.fill}",
      "textColor": "${color.primary.on}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.primary.hover}" }
      }
    },
    "app.secondaryChip": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.selectableLabelSelected": {
      "textColor": "${color.primary.on}",
      "fontSize": "20sp"
    },
    "app.buttonPrimary": {
      "bgColor": "${color.primary.fill}",
      "textColor": "${color.primary.on}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.primary.hover}" }
      }
    },
    "app.buttonSecondary": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.caption": {
      "textColor": "${color.text.muted}",
      "fontSize": "20sp"
    },
    "app.card": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "18dp"
    },
    "app.cardSubtitle": {
      "textColor": "${color.text.muted}",
      "fontSize": "20sp"
    },
    "app.cardTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.iconBox": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.iconRecolor": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItem": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItemTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItemValue": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.page": {
      "bgColor": "${color.bg.base}",
      "textColor": "${color.text.default}"
    },
    "app.pageTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.selectableCard": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.slider": {
      "partStyles": {
        "indicator": {
          "bgColor": "${color.primary.fill}",
          "radius": "10dp"
        },
        "knob": {
          "bgColor": "${color.control.knob}",
          "radius": "16dp",
          "padding": "4dp"
        }
      },
      "bgColor": "${color.border.default}",
      "radius": "10dp"
    },
    "app.switch": {
      "partStyles": {
        "indicator": {
          "style": {
            "bgColor": "${color.border.default}",
            "radius": "20dp"
          },
          "stateStyles": {
            "checked": {
              "bgColor": "${color.primary.fill}"
            }
          }
        },
        "knob": {
          "bgColor": "${color.control.knob}",
          "radius": "18dp"
        }
      },
      "bgColor": "${color.border.default}",
      "radius": "20dp"
    },
    "app.action": {
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.primary.hover}"
        }
      },
      "bgColor": "${color.primary.fill}"
    },
    "app.actionText": {
      "textColor": "${color.primary.on}"
    },
    "shell.page": {
      "bgColor": "${color.bg.base}"
    },
    "shell.text": {
      "textColor": "${color.text.default}"
    },
    "shell.caption": {
      "textColor": "${color.text.muted}"
    },
    "shell.hint": {
      "textColor": "${color.text.subtle}"
    },
    "shell.accent": {
      "bgColor": "${color.primary.fill}"
    },
    "shell.batteryPage": {
      "bgColor": "${color.success.soft}"
    },
    "shell.batteryTitle": {
      "textColor": "${color.success.fill}"
    },
    "shell.brightnessPage": {
      "bgColor": "${color.warning.soft}"
    },
    "shell.brightnessTitle": {
      "textColor": "${color.warning.fill}"
    },
    "shell.watchPage": {
      "bgColor": "${color.bg.base}"
    },
    "shell.quickPage": {
      "bgColor": "${color.bg.quick}"
    },
    "shell.launcherPage": {
      "bgColor": "${color.bg.base}"
    },
    "shell.row": {
      "bgColor": "${color.surface.raised}",
      "borderColor": "${color.border.default}",
      "borderWidth": "1dp",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.surface.pressed}"
        }
      }
    },
    "shell.rowText": {
      "textColor": "${color.text.default}"
    },
    "shell.brightnessAction": {
      "bgColor": "${color.warning.soft}",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.warning.soft}",
          "borderColor": "${color.warning.fill}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.brightnessActionText": {
      "textColor": "${color.warning.fill}"
    },
    "shell.wifiAction": {
      "bgColor": "${color.info.soft}",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.info.soft}",
          "borderColor": "${color.primary.fill}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.wifiActionText": {
      "textColor": "${color.info.fill}"
    },
    "shell.brightnessPrimary": {
      "bgColor": "${color.warning.fill}",
      "stateStyles": {
        "pressed": {
          "borderColor": "${color.warning.on}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.brightnessPrimaryText": {
      "textColor": "${color.warning.on}"
    }
  }
}
