{
  "type": "theme",
  "id": "light",
  "assets": [
    {
      "type": "constant",
      "data": {
        "colors": {
          "border": {
            "default": "#bbc7d5",
            "muted": "#e5ebf2",
            "strong": "#617085"
          },
          "text": {
            "default": "#152233",
            "muted": "#516174",
            "subtle": "#617085",
            "inverse": "#ffffff"
          },
          "primary": {
            "fill": "#2157d5",
            "on": "#ffffff",
            "soft": "#deedff",
            "hover": "#1944aa"
          },
          "bg": {
            "base": "#f3f6fa",
            "overlay": "#ffffff",
            "app": "#f3f6fa",
            "scrim": "#07090d",
            "quick": "#edf3fb"
          },
          "info": {
            "fill": "#2157d5",
            "soft": "#deedff",
            "on": "#ffffff"
          },
          "warning": {
            "fill": "#875500",
            "soft": "#fff0cc",
            "on": "#ffffff"
          },
          "surface": {
            "base": "#f3f6fa",
            "raised": "#ffffff",
            "muted": "#e5ebf2",
            "pressed": "#deedff",
            "inverse": "#152233"
          },
          "success": {
            "fill": "#187642",
            "soft": "#e0f2e7",
            "on": "#ffffff"
          },
          "danger": {
            "fill": "#a52832",
            "soft": "#fde8ea",
            "on": "#ffffff"
          },
          "control": {
            "knob": "#ffffff"
          }
        }
      }
    }
  ],
  "styles": {
    "button": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.primaryChip": {
      "bgColor": "${color.primary.fill}",
      "textColor": "${color.primary.on}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.primary.hover}" }
      }
    },
    "app.secondaryChip": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.selectableLabelSelected": {
      "textColor": "${color.primary.on}",
      "fontSize": "20sp"
    },
    "app.buttonPrimary": {
      "bgColor": "${color.primary.fill}",
      "textColor": "${color.primary.on}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.primary.hover}" }
      }
    },
    "app.buttonSecondary": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "16dp",
      "stateStyles": {
        "pressed": { "bgColor": "${color.surface.pressed}" }
      }
    },
    "app.caption": {
      "textColor": "${color.text.muted}",
      "fontSize": "20sp"
    },
    "app.card": {
      "bgColor": "${color.surface.raised}",
      "textColor": "${color.text.default}",
      "radius": "18dp"
    },
    "app.cardSubtitle": {
      "textColor": "${color.text.muted}",
      "fontSize": "20sp"
    },
    "app.cardTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.iconBox": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.iconRecolor": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItem": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItemTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.listItemValue": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.page": {
      "bgColor": "${color.bg.base}",
      "textColor": "${color.text.default}"
    },
    "app.pageTitle": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.selectableCard": {
      "textColor": "${color.text.default}",
      "fontSize": "20sp"
    },
    "app.slider": {
      "partStyles": {
        "indicator": {
          "bgColor": "${color.primary.fill}",
          "radius": "10dp"
        },
        "knob": {
          "bgColor": "${color.control.knob}",
          "radius": "16dp",
          "padding": "4dp"
        }
      },
      "bgColor": "${color.border.default}",
      "radius": "10dp"
    },
    "app.switch": {
      "partStyles": {
        "indicator": {
          "style": {
            "bgColor": "${color.border.default}",
            "radius": "20dp"
          },
          "stateStyles": {
            "checked": {
              "bgColor": "${color.primary.fill}"
            }
          }
        },
        "knob": {
          "bgColor": "${color.control.knob}",
          "radius": "18dp"
        }
      },
      "bgColor": "${color.border.default}",
      "radius": "20dp"
    },
    "app.action": {
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.primary.hover}"
        }
      },
      "bgColor": "${color.primary.fill}"
    },
    "app.actionText": {
      "textColor": "${color.primary.on}"
    },
    "shell.page": {
      "bgColor": "${color.bg.base}"
    },
    "shell.text": {
      "textColor": "${color.text.default}"
    },
    "shell.caption": {
      "textColor": "${color.text.muted}"
    },
    "shell.hint": {
      "textColor": "${color.text.subtle}"
    },
    "shell.accent": {
      "bgColor": "${color.primary.fill}"
    },
    "shell.batteryPage": {
      "bgColor": "${color.success.soft}"
    },
    "shell.batteryTitle": {
      "textColor": "${color.success.fill}"
    },
    "shell.brightnessPage": {
      "bgColor": "${color.warning.soft}"
    },
    "shell.brightnessTitle": {
      "textColor": "${color.warning.fill}"
    },
    "shell.watchPage": {
      "bgColor": "${color.bg.base}"
    },
    "shell.quickPage": {
      "bgColor": "${color.bg.quick}"
    },
    "shell.launcherPage": {
      "bgColor": "${color.bg.base}"
    },
    "shell.row": {
      "bgColor": "${color.surface.raised}",
      "borderColor": "${color.border.default}",
      "borderWidth": "1dp",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.surface.pressed}"
        }
      }
    },
    "shell.rowText": {
      "textColor": "${color.text.default}"
    },
    "shell.brightnessAction": {
      "bgColor": "${color.warning.soft}",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.warning.soft}",
          "borderColor": "${color.warning.fill}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.brightnessActionText": {
      "textColor": "${color.warning.fill}"
    },
    "shell.wifiAction": {
      "bgColor": "${color.info.soft}",
      "stateStyles": {
        "pressed": {
          "bgColor": "${color.info.soft}",
          "borderColor": "${color.primary.fill}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.wifiActionText": {
      "textColor": "${color.info.fill}"
    },
    "shell.brightnessPrimary": {
      "bgColor": "${color.warning.fill}",
      "stateStyles": {
        "pressed": {
          "borderColor": "${color.warning.on}",
          "borderWidth": "2dp"
        }
      }
    },
    "shell.brightnessPrimaryText": {
      "textColor": "${color.warning.on}"
    }
  }
}
