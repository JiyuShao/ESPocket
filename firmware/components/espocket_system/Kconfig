menu "ESPocket"

    config ESPOCKET_M2_LIFECYCLE_STRESS
        bool "Run the M2 Native App lifecycle stress test at boot"
        default n
        help
            Start and stop Hello Native 50 times before starting Circular Shell.
            This emits deterministic lifecycle and heap samples for M2 acceptance
            and must remain disabled in normal interactive firmware builds.

    config ESPOCKET_M6_SCREEN_TIMEOUT_SECONDS
        int "M6 global screen timeout in seconds"
        range 0 3600
        default 30
        help
            Turn the display off after this many seconds without touch input.
            Set to 0 for the global Never setting. Apps cannot override it.

    config ESPOCKET_M6_RECLAIM_ON_TIMEOUT_TEST
        bool "M6 test: stop the foreground App after automatic screen-off"
        default n
        help
            Test firmware only. After automatic screen-off with a visible App,
            stop that App through System Core to invalidate the saved resume
            target. The next PWR wake must show Watch Face without restarting
            the App. Leave disabled in normal interactive firmware.

    config ESPOCKET_M8_CARD_SAMPLE_TEST
        bool "M8 test: show Native/Runtime Card samples with a temporary configuration"
        default n
        help
            With persisted Developer Mode enabled and an empty restored Card
            configuration, place Native summary/detail on the left and Runtime
            summary/detail on the right. This fixture is RAM only, not a Card
            editor and never writes NVS. Leave disabled in normal firmware.

    config ESPOCKET_M8_RECLAIM_NATIVE_TEST
        bool "M8 test: reclaim only Native Apps after automatic screen-off"
        default n
        help
            Stop only the visible Native resume target through System Core.
            Runtime Apps retain their current Page. Old Page/Back/keyboard
            resources follow ordinary Core stop cleanup. Wake shows Watch Face;
            a later user launch starts at Root. Leave disabled in normal firmware.

    config ESPOCKET_M8_RECLAIM_RUNTIME_TEST
        bool "M8 test: reclaim only Runtime Apps after automatic screen-off"
        default n
        help
            Stop only the visible Runtime resume target through System Core.
            Native Apps retain their current Page. This is a bounded test seam,
            not a low-memory killer or a new USB command. Leave disabled normally.

    config ESPOCKET_M6_RESOURCE_TRACE
        bool "M6 test: log heap at Watch Face before PWR screen-off"
        default n
        help
            Test firmware only. Emit internal and PSRAM free/largest heap
            metrics at a repeatable Watch Face checkpoint after each App Home
            transition. Leave disabled in normal interactive firmware.

endmenu
