          "children": [
            {
              "type": "label",
              "id": "label",
              "labelProps": {
                "text": "Open Detail"
              },
              "style": {
                "fontSize": "18sp"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "styleRefs": [
                "app.actionText"
              ]
            }
          ],
          "styleRefs": [
            "app.action"
          ]
        }
      ],
      "styleRefs": [
        "app.page"
      ]
    },
    {
      "type": "viewScreen",
      "id": "detail",
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "padding": 0
      },
      "layout": {
        "type": "flex",
        "flexFlow": "column",
        "mainAlign": "center",
        "crossAlign": "center",
        "gap": "12dp"
      },
      "children": [
        {
