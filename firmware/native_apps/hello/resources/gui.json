          "style": {
            "radius": "22dp"
          },
          "placement": {
            "width": "230dp",
            "height": "46dp"
          },
          "children": [
            {
              "type": "label",
              "id": "label",
              "labelProps": {
                "text": "Allow Back"
              },
              "style": {
                "fontSize": "17sp"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "styleRefs": [
                "app.actionText"
              ]
            }
          ],
          "styleRefs": [
            "app.action"
          ]
        },
        {
          "type": "button",
          "id": "cancel",
          "events": [
            {
              "type": "clicked",
              "action": "hello.cancel_back"
            }
          ],
          "style": {
            "radius": "22dp"
          },
          "placement": {
            "width": "230dp",
            "height": "46dp"
          },
          "children": [
            {
              "type": "label",
              "id": "label",
              "labelProps": {
                "text": "Cancel Back"
              },
              "style": {
                "fontSize": "17sp"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
