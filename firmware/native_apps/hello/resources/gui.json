      ]
    },
    {
      "type": "screenFlow",
      "id": "main",
      "screens": [
        "root",
        "detail"
      ],
      "initial": "root",
      "transitions": [
        {
          "from": [
            "root"
          ],
          "action": "open_detail",
          "to": "detail"
        },
        {
          "from": [
            "detail"
          ],
          "action": "back_root",
          "to": "root"
        }
      ]
    }
