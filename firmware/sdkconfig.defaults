CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=40960
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16m.csv"
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n

CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=48000
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_32=y

CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_BUFFER_HEIGHT=50
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_REQUIRE_DOUBLE_BUFFER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_BROOKESIA_SERVICE_DISPLAY_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SERVICE_DEVICE_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SERVICE_WIFI_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SERVICE_SNTP_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_STORAGE_DEVICE=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_ENABLE_FILE_SYSTEM_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_ENABLE_LITTLEFS=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_LITTLEFS_FORMAT_IF_MOUNT_FAILED=y
CONFIG_BROOKESIA_RUNTIME_JS_ENABLE_AUTO_REGISTER=y
# The GUI/worker baseline leaves insufficient internal RAM for the PSRAM-oriented
# Wi-Fi defaults (16 x 1.6 KiB static RX buffers). Ten RX buffers and a matching
# AMPDU window retain the ESP-IDF low-memory baseline and release about 9.6 KiB.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=10
CONFIG_BROOKESIA_SYSTEM_CORE_WORKER_STACK_SIZE=94208
# Store-path measurement used 8,688 bytes; 12 KiB retains 3,600 bytes while
# 16 KiB per internal worker prevents the 46,600-byte LVGL buffer allocation.
CONFIG_BROOKESIA_SERVICE_MANAGER_SECONDARY_SCHEDULER_WORKER_STACK_SIZE=12288

# M4 keeps Audio disabled. HAL Adaptor 0.8.4 cannot resolve its conditional
# processor dependencies when recorder is disabled, and enabling recorder just
# to expose playback would violate the product boundary.
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_AUDIO_DEVICE=n
CONFIG_BROOKESIA_SERVICE_AUDIO_ENABLE_AUTO_REGISTER=n
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_VIDEO_DEVICE=n

# M5 keeps official HTTP transport verification enabled. This secures the TLS
# connection but is not a substitute for BPK digest/signature verification.
CONFIG_BROOKESIA_SERVICE_STORAGE_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SERVICE_HTTP_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SERVICE_HTTP_ENABLE_HTTPS=y
CONFIG_BROOKESIA_SERVICE_HTTP_REQUIRE_TLS_VERIFY=y
CONFIG_BROOKESIA_SERVICE_HTTP_REQUIRE_TIME_SYNC=y
# Mbed TLS uses internal RAM in this baseline. One active request avoids
# overlapping TLS allocations, but does not serialize scheduler-free cancellation
# against the active worker transaction or fix the upstream HTTP cancellation race.
CONFIG_BROOKESIA_SERVICE_HTTP_WORKER_NUM=2
CONFIG_BROOKESIA_SERVICE_HTTP_MAX_CONCURRENT_REQUESTS=1
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_BROOKESIA_SYSTEM_CORE_ENABLE_USB_BRIDGE=n
CONFIG_BROOKESIA_SERVICE_USB_ENABLE_AUTO_REGISTER=n
